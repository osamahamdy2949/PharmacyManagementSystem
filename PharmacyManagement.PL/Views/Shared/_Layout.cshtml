@using PharmacyManagement.DAL.Common
@{
    var isAdmin = User.IsInRole(RoleNames.Administrator);
    var isAdminOrPharmacist = isAdmin || User.IsInRole(RoleNames.Pharmacist);
}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pharmacy Management</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script>
        (() => {
            const theme = localStorage.getItem('pms-theme') || 'light';
            const lang = localStorage.getItem('pms-lang') || 'en';
            document.documentElement.dataset.theme = theme;
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="app-shell d-flex min-vh-100">
        <!-- Left Sidebar -->
        <aside class="sidebar bg-white border-end d-flex flex-column flex-shrink-0" id="sidebar" style="width: 260px; transition: all 0.3s ease;">
            <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
                <a class="text-decoration-none d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/pharmacy-icon.svg" alt="Logo" width="32" height="32" />
                    <span class="fs-5 fw-bold text-primary">Pharmacy MS</span>
                </a>
                <button class="btn btn-sm d-lg-none" type="button" id="closeSidebar"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <div class="flex-grow-1 p-3 sidebar-nav">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill me-3 text-primary opacity-75"></i><span data-i18n="nav.dashboard">Dashboard</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Medicine" asp-action="Index"><i class="bi bi-capsule me-3 text-warning opacity-75"></i><span data-i18n="nav.medicines">Medicines</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="SalesInvoice" asp-action="Pos"><i class="bi bi-cart-plus-fill me-3 text-success opacity-75"></i><span data-i18n="nav.newSale">New Sale (POS)</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="SalesInvoice" asp-action="Index"><i class="bi bi-receipt me-3 text-secondary opacity-75"></i><span data-i18n="nav.salesHistory">Sales History</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Customer" asp-action="Index"><i class="bi bi-people-fill me-3 text-info opacity-75"></i><span data-i18n="nav.customers">Customers</span></a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-controller="Payment" asp-action="Index"><i class="bi bi-cash-stack me-3 text-secondary opacity-75"></i><span data-i18n="nav.payments">Payments</span></a>
                    </li>
                    <li class="nav-item mt-3 mb-1">
                        <a data-bs-toggle="collapse" href="#managementSection" role="button" aria-expanded="false" aria-controls="managementSection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                            <span data-i18n="nav.management">Management</span> <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="nav-item w-100">
                        <ul class="nav flex-column collapse" id="managementSection">
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium ps-4" asp-controller="Shift" asp-action="Current"><i class="bi bi-clock-history me-3 text-primary opacity-75"></i><span data-i18n="nav.currentShift">Current Shift</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium ps-4" asp-controller="Shift" asp-action="History"><i class="bi bi-journal-text me-3 text-secondary opacity-75"></i><span data-i18n="nav.shiftHistory">Shift History</span></a>
                            </li>
                        </ul>
                    </li>
                    @if (isAdminOrPharmacist)
                    {
                        <li class="nav-item mt-3 mb-1">
                            <a data-bs-toggle="collapse" href="#inventorySection" role="button" aria-expanded="false" aria-controls="inventorySection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                                <span data-i18n="nav.inventory">Inventory</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item w-100">
                            <ul class="nav flex-column collapse" id="inventorySection">
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Category" asp-action="Index"><i class="bi bi-tags-fill me-3 text-secondary opacity-75"></i><span data-i18n="nav.categories">Categories</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck me-3 text-secondary opacity-75"></i><span data-i18n="nav.suppliers">Suppliers</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam-fill me-3 text-secondary opacity-75"></i><span data-i18n="nav.stock">Stock</span></a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item mt-3 mb-1">
                            <a data-bs-toggle="collapse" href="#purchasesSection" role="button" aria-expanded="false" aria-controls="purchasesSection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                                <span data-i18n="nav.purchases">Purchases</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item w-100">
                            <ul class="nav flex-column collapse" id="purchasesSection">
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="PurchaseInvoice" asp-action="Index"><i class="bi bi-bag-plus-fill me-3 text-secondary opacity-75"></i><span data-i18n="nav.invoices">Invoices</span></a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item mt-3 mb-1">
                            <a data-bs-toggle="collapse" href="#returnsSection" role="button" aria-expanded="false" aria-controls="returnsSection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                                <span data-i18n="nav.returns">Returns</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item w-100">
                            <ul class="nav flex-column collapse" id="returnsSection">
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="PurchaseReturn" asp-action="Index"><i class="bi bi-arrow-return-left me-3 text-secondary opacity-75"></i><span data-i18n="nav.purchaseReturns">Purchase Returns</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="SalesReturn" asp-action="Index"><i class="bi bi-arrow-return-right me-3 text-secondary opacity-75"></i><span data-i18n="nav.salesReturns">Sales Returns</span></a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item mt-3 mb-1">
                            <a data-bs-toggle="collapse" href="#reportsSection" role="button" aria-expanded="false" aria-controls="reportsSection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                                <span data-i18n="nav.reports">Reports</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item w-100">
                            <ul class="nav flex-column collapse" id="reportsSection">
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Reports" asp-action="ProfitReport"><i class="bi bi-graph-up me-3 text-success opacity-75"></i><span data-i18n="nav.profit">Profit</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Reports" asp-action="TopSellingMedicinesReport"><i class="bi bi-star-fill me-3 text-warning opacity-75"></i><span data-i18n="nav.topSelling">Top Selling</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Reports" asp-action="FinishedMedicinesReport"><i class="bi bi-exclamation-triangle-fill me-3 text-danger opacity-75"></i><span data-i18n="nav.outOfStock">Out of Stock</span></a>
                                </li>
                            </ul>
                        </li>
                    }
                    
                    @if (isAdmin)
                    {
                        <li class="nav-item mt-3 mb-1">
                            <a data-bs-toggle="collapse" href="#adminSection" role="button" aria-expanded="false" aria-controls="adminSection" class="sidebar-collapse-btn text-uppercase text-muted fw-bold letter-spacing-1 small ms-3 d-flex justify-content-between align-items-center text-decoration-none pe-3">
                                <span data-i18n="nav.admin">Admin</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item w-100">
                            <ul class="nav flex-column collapse" id="adminSection">
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-3 text-secondary opacity-75"></i><span data-i18n="nav.users">Users</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="AuditLog" asp-action="Index"><i class="bi bi-shield-lock me-3 text-secondary opacity-75"></i><span data-i18n="nav.auditLogs">Audit Logs</span></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium ps-4" asp-controller="LoginTracking" asp-action="Index"><i class="bi bi-person-lines-fill me-3 text-secondary opacity-75"></i><span data-i18n="nav.loginHistory">Login History</span></a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
            <div class="p-3 border-top mt-auto">
                <div class="text-center text-muted small">&copy; @DateTime.Now.Year <span data-i18n="brand.short">Pharmacy MS</span></div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0; height: 100vh;">
            
            <!-- Top Navbar -->
            <header class="bg-white border-bottom shadow-sm px-4 py-3 d-flex align-items-center justify-content-between position-sticky top-0 z-3">
                <div class="d-flex align-items-center gap-3 w-50">
                    <button class="btn btn-light d-lg-none" type="button" id="toggleSidebar"><i class="bi bi-list fs-5"></i></button>
                    <form class="search-form w-100 position-relative" asp-controller="Search" asp-action="Index" method="get">
                        <i class="bi bi-search position-absolute text-muted" style="top: 50%; transform: translateY(-50%); left: 15px;"></i>
                        <input type="search" name="q" class="form-control bg-light border-0 rounded-pill ps-5" data-i18n-placeholder="search.placeholder" placeholder="Search medicines, suppliers..." value="@Context.Request.Query["q"]" />
                    </form>
                </div>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="theme-language-controls">
                            <button type="button" class="btn btn-light shell-icon-btn" id="themeToggle" title="Toggle dark mode" aria-label="Toggle dark mode">
                                <i class="bi bi-moon-stars"></i>
                            </button>
                            <button type="button" class="btn btn-light" id="languageToggle" title="Switch language" aria-label="Switch language">AR</button>
                        </div>
                    <div class="dropdown">
                        <a class="text-decoration-none d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <div class="text-end d-none d-md-block">
                                <div class="fw-bold text-dark lh-1">@User.Identity.Name</div>
                                <small class="text-muted" data-i18n="user.staff">Pharmacy Staff</small>
                            </div>
                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm border border-primary-subtle" style="width: 40px; height: 40px;">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold"><i class="bi bi-box-arrow-right me-2"></i><span data-i18n="action.logout">Logout</span></button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    </div>
                }
            </header>

            <!-- Main Scrollable Area -->
            <main class="flex-grow-1 p-4 overflow-auto">
                <div class="container-fluid max-w-1200">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                            <div>@TempData["Error"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>
                                @TempData["Success"]
                                @if (TempData["RestockInvoiceId"] != null)
                                {
                                    <a asp-controller="Reports" asp-action="DownloadRestockReceipt" asp-route-id="@TempData["RestockInvoiceId"]" class="alert-link ms-2 text-decoration-underline">Download receipt PDF</a>
                                }
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('toggleSidebar')?.addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('show-mobile');
        });
        document.getElementById('closeSidebar')?.addEventListener('click', () => {
            document.getElementById('sidebar').classList.remove('show-mobile');
        });
        
        // Highlight active link and expand its parent dropdown if needed
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
            const navLinks = Array.from(document.querySelectorAll('.sidebar .nav-link'));
            const normalizePath = href => {
                const path = new URL(href, window.location.origin).pathname.toLowerCase().replace(/\/$/, '');
                return path || '/';
            };

            const bestMatch = navLinks
                .map(link => ({ link, path: normalizePath(link.getAttribute('href') || '/') }))
                .filter(item =>
                    item.path === '/'
                        ? currentPath === '/' || currentPath === '/home' || currentPath === '/home/index'
                        : currentPath === item.path || currentPath.startsWith(`${item.path}/`))
                .sort((a, b) => b.path.length - a.path.length)[0];

            if (!bestMatch) return;

            bestMatch.link.classList.add('active');
            bestMatch.link.classList.remove('text-dark');

            const collapseParent = bestMatch.link.closest('.collapse');
            if (collapseParent) {
                collapseParent.classList.add('show');
                const btn = document.querySelector(`[aria-controls="${collapseParent.id}"]`);
                if (btn) btn.setAttribute('aria-expanded', 'true');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
