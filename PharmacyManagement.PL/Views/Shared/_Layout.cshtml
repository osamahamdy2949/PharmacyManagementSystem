@using PharmacyManagement.DAL.Common
@{
    var isAdmin = User.IsInRole(RoleNames.Administrator);
    var isAdminOrPharmacist = isAdmin || User.IsInRole(RoleNames.Pharmacist);
}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pharmacy Management</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script>
        (() => {
            const theme = localStorage.getItem('pms-theme') || 'light';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ── Sidebar Overhaul ── */
        .sidebar {
            background: #FFFFFF !important;
            border-right: 1px solid #E2E8F0 !important;
            display: flex;
            flex-direction: column;
        }

        /* Dark mode sidebar */
        [data-theme="dark"] .sidebar {
            background: #080E20 !important;
            border-right: 1px solid rgba(255,255,255,0.06) !important;
        }

        .sidebar .brand-area {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid #E2E8F0;
        }
        [data-theme="dark"] .sidebar .brand-area {
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .sidebar-logo-wrap {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }
        .sidebar-logo-img {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.25);
        }
        .sidebar-logo-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: #0F172A;
            letter-spacing: -0.01em;
        }
        [data-theme="dark"] .sidebar-logo-name { color: #F1F5F9; }
        .sidebar-logo-tag {
            font-size: 0.65rem;
            color: #94A3B8;
            font-weight: 500;
        }

        /* Nav links — light mode */
        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.6rem 0.9rem;
            border-radius: 8px;
            margin: 1px 0.5rem;
            font-size: 0.85rem;
            font-weight: 500;
            color: #475569 !important;
            transition: all 0.15s ease;
            text-decoration: none;
            position: relative;
        }
        .sidebar .nav-link:hover {
            color: #0F172A !important;
            background: #F1F5F9 !important;
        }
        .sidebar .nav-link.active {
            color: #4F46E5 !important;
            background: #EEF2FF !important;
            font-weight: 600;
        }
        .sidebar .nav-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 3px;
            background: #6366F1;
            border-radius: 0 3px 3px 0;
        }
        .sidebar .nav-link i {
            font-size: 0.95rem;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
            opacity: 0.6;
        }
        .sidebar .nav-link:hover i,
        .sidebar .nav-link.active i { opacity: 1; }

        /* Nav links — dark mode override */
        [data-theme="dark"] .sidebar .nav-link { color: #64748B !important; }
        [data-theme="dark"] .sidebar .nav-link:hover {
            color: #E2E8F0 !important;
            background: rgba(255,255,255,0.05) !important;
        }
        [data-theme="dark"] .sidebar .nav-link.active {
            color: #FFFFFF !important;
            background: rgba(99,102,241,0.18) !important;
        }

        .sidebar-collapse-btn {
            font-size: 0.62rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            color: #94A3B8 !important;
            padding: 1.25rem 1rem 0.4rem !important;
            margin: 0 !important;
            border-radius: 0 !important;
            background: none !important;
        }
        .sidebar-collapse-btn:hover { color: #64748B !important; background: none !important; }
        .sidebar-collapse-btn i { font-size: 0.6rem !important; transition: transform 0.2s; }
        .sidebar-collapse-btn[aria-expanded="true"] i { transform: rotate(90deg); }

        .sidebar .collapse .nav-link {
            padding-left: 2.25rem;
            font-size: 0.82rem;
        }

        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid #E2E8F0;
        }
        [data-theme="dark"] .sidebar-footer { border-top: 1px solid rgba(255,255,255,0.06); }
        .sidebar-footer-text {
            font-size: 0.7rem;
            color: #CBD5E1;
            text-align: center;
        }

        /* ── App Header ── */
        .app-header {
            background: var(--color-surface) !important;
            border-bottom: 1px solid var(--color-border);
            height: 60px;
            padding: 0 1.5rem;
        }
        .header-search input {
            background: var(--color-bg-subtle) !important;
            border: 1px solid var(--color-border) !important;
            border-radius: 8px !important;
            font-size: 0.85rem;
            padding-left: 2.5rem !important;
        }
        .header-search input:focus {
            background: var(--color-surface) !important;
            border-color: var(--color-primary) !important;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1) !important;
        }
        .header-search .search-icon {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--color-text-muted);
            font-size: 0.85rem;
        }

        .header-avatar {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: linear-gradient(135deg, #4F46E5, #6366F1);
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .header-user-name { font-size: 0.85rem; font-weight: 600; color: var(--color-text-main); line-height: 1.2; }
        .header-user-role { font-size: 0.72rem; color: var(--color-text-muted); }

        .header-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--color-border);
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-text-muted);
            cursor: pointer;
            transition: all 0.15s;
            font-size: 0.9rem;
        }
        .header-icon-btn:hover {
            background: var(--color-bg-subtle);
            color: var(--color-text-main);
        }
        .dropdown-menu { border-radius: 12px; border: 1px solid var(--color-border); box-shadow: 0 10px 30px rgba(0,0,0,0.12); }
    </style>
</head>
<body>
    <div class="app-shell d-flex min-vh-100">

        <!-- ── Sidebar ── -->
        <aside class="sidebar flex-shrink-0" id="sidebar" style="width: 240px;">
            <div class="brand-area">
                <a class="sidebar-logo-wrap" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-3d.png" alt="Logo" class="sidebar-logo-img" />
                    <div>
                        <div class="sidebar-logo-name">Pharmacy MS</div>
                        <div class="sidebar-logo-tag">Management System</div>
                    </div>
                </a>
                <button class="btn btn-sm d-lg-none mt-2" style="color:#64748B;" type="button" id="closeSidebar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="flex-grow-1 py-2 overflow-auto sidebar-nav">
                <ul class="nav flex-column gap-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Medicine" asp-action="Index">
                            <i class="bi bi-capsule"></i> Medicines
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SalesInvoice" asp-action="Pos">
                            <i class="bi bi-cart-plus"></i> New Sale (POS)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SalesInvoice" asp-action="Index">
                            <i class="bi bi-receipt"></i> Sales History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-people"></i> Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Payment" asp-action="Index">
                            <i class="bi bi-cash-stack"></i> Payments
                        </a>
                    </li>

                    <!-- Management -->
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" href="#managementSection" role="button" aria-expanded="false" aria-controls="managementSection"
                           class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                            <span>Management</span> <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <ul class="nav flex-column collapse" id="managementSection">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shift" asp-action="Current">
                                    <i class="bi bi-clock-history"></i> Current Shift
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Shift" asp-action="History">
                                    <i class="bi bi-journal-text"></i> Shift History
                                </a>
                            </li>
                        </ul>
                    </li>

                    @if (isAdminOrPharmacist)
                    {
                        <!-- Inventory -->
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" href="#inventorySection" role="button" aria-expanded="false" aria-controls="inventorySection"
                               class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                                <span>Inventory</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <ul class="nav flex-column collapse" id="inventorySection">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags"></i> Categories
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Supplier" asp-action="Index">
                                        <i class="bi bi-truck"></i> Suppliers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Inventory" asp-action="Index">
                                        <i class="bi bi-box-seam"></i> Stock
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Purchases -->
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" href="#purchasesSection" role="button" aria-expanded="false" aria-controls="purchasesSection"
                               class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                                <span>Purchases</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <ul class="nav flex-column collapse" id="purchasesSection">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="PurchaseInvoice" asp-action="Index">
                                        <i class="bi bi-bag-plus"></i> Invoices
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Returns -->
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" href="#returnsSection" role="button" aria-expanded="false" aria-controls="returnsSection"
                               class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                                <span>Returns</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <ul class="nav flex-column collapse" id="returnsSection">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="PurchaseReturn" asp-action="Index">
                                        <i class="bi bi-arrow-return-left"></i> Purchase Returns
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="SalesReturn" asp-action="Index">
                                        <i class="bi bi-arrow-return-right"></i> Sales Returns
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Reports -->
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" href="#reportsSection" role="button" aria-expanded="false" aria-controls="reportsSection"
                               class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                                <span>Reports</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <ul class="nav flex-column collapse" id="reportsSection">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="ProfitReport">
                                        <i class="bi bi-graph-up"></i> Profit
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="TopSellingMedicinesReport">
                                        <i class="bi bi-star"></i> Top Selling
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="FinishedMedicinesReport">
                                        <i class="bi bi-exclamation-triangle"></i> Out of Stock
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @if (isAdmin)
                    {
                        <!-- Admin -->
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" href="#adminSection" role="button" aria-expanded="false" aria-controls="adminSection"
                               class="nav-link sidebar-collapse-btn d-flex justify-content-between align-items-center text-decoration-none">
                                <span>Admin</span> <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <ul class="nav flex-column collapse" id="adminSection">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-person-gear"></i> Users
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AuditLog" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i> Audit Logs
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="LoginTracking" asp-action="Index">
                                        <i class="bi bi-person-lines-fill"></i> Login History
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-footer-text">&copy; @DateTime.Now.Year Pharmacy MS</div>
            </div>
        </aside>

        <!-- ── Main Workspace ── -->
        <div class="main-workspace">

            <!-- Header -->
            <header class="app-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3" style="flex: 1; max-width: 480px;">
                    <button class="header-icon-btn d-lg-none" type="button" id="toggleSidebar" aria-label="Menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="header-search position-relative w-100">
                        <i class="bi bi-search search-icon"></i>
                        <form asp-controller="Search" asp-action="Index" method="get">
                            <input type="search" name="q" class="form-control" placeholder="Search medicines, suppliers..." value="@Context.Request.Query["q"]" />
                        </form>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="header-icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
                            <i class="bi bi-moon-stars"></i>
                        </button>
                        <div class="dropdown">
                            <a class="text-decoration-none d-flex align-items-center gap-2 p-1" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="text-end d-none d-md-block me-1">
                                    <div class="header-user-name">@(User.Identity.Name?.Split('@')[0] ?? "User")</div>
                                    <div class="header-user-role">Pharmacy Staff</div>
                                </div>
                                <div class="header-avatar">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 py-1">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-semibold">
                                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </header>

            <!-- Main Content -->
            <main class="flex-grow-1">
                <div class="main-container">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                            <div>@TempData["Error"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>
                                @TempData["Success"]
                                @if (TempData["RestockInvoiceId"] != null)
                                {
                                    <a asp-controller="Reports" asp-action="DownloadRestockReceipt" asp-route-id="@TempData["RestockInvoiceId"]" class="alert-link ms-2 text-decoration-underline">Download receipt PDF</a>
                                }
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('toggleSidebar')?.addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('show-mobile');
        });
        document.getElementById('closeSidebar')?.addEventListener('click', () => {
            document.getElementById('sidebar').classList.remove('show-mobile');
        });

        // Highlight active nav link — sections stay collapsed by default, user controls them manually
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Restore collapse state from sessionStorage (user's manual choices)
            document.querySelectorAll('.sidebar .collapse').forEach(function(collapseEl) {
                var key = 'sidebar-' + collapseEl.id;
                var isOpen = sessionStorage.getItem(key) === 'true';
                if (isOpen) {
                    collapseEl.classList.add('show');
                    var btn = document.querySelector('[aria-controls="' + collapseEl.id + '"]');
                    if (btn) btn.setAttribute('aria-expanded', 'true');
                }
            });

            // 2. Save state when user clicks a collapse toggle
            document.querySelectorAll('.sidebar-collapse-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var targetId = btn.getAttribute('href')?.replace('#', '') ||
                                   btn.getAttribute('data-bs-target')?.replace('#', '');
                    if (!targetId) return;
                    var collapseEl = document.getElementById(targetId);
                    if (!collapseEl) return;
                    // State will flip after Bootstrap animates; listen once on the collapse events
                    collapseEl.addEventListener('shown.bs.collapse', function() {
                        sessionStorage.setItem('sidebar-' + targetId, 'true');
                    }, { once: true });
                    collapseEl.addEventListener('hidden.bs.collapse', function() {
                        sessionStorage.setItem('sidebar-' + targetId, 'false');
                    }, { once: true });
                });
            });

            // 3. Highlight active link (no auto-expand)
            var currentPath = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
            var navLinks = Array.from(document.querySelectorAll('.sidebar .nav-link:not(.sidebar-collapse-btn)'));
            var normalizePath = function(href) {
                var path = new URL(href, window.location.origin).pathname.toLowerCase().replace(/\/$/, '');
                return path || '/';
            };
            var bestMatch = navLinks
                .map(function(link) { return { link: link, path: normalizePath(link.getAttribute('href') || '/') }; })
                .filter(function(item) {
                    return item.path === '/'
                        ? currentPath === '/' || currentPath === '/home' || currentPath === '/home/index'
                        : currentPath === item.path || currentPath.startsWith(item.path + '/');
                })
                .sort(function(a, b) { return b.path.length - a.path.length; })[0];

            if (bestMatch) {
                bestMatch.link.classList.add('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
