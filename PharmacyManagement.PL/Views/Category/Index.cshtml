@model IEnumerable<CategoryViewModel>
@{ 
    ViewData["Title"] = "Categories"; 
    ViewData["PageTitle"] = "Categories"; 
    ViewData["PageIcon"] = "bi-tags";
    ViewData["AddUrl"] = Url.Action("Create"); 
}
<partial name="_PageHeader" />

<div class="content-card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-enterprise mb-0">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="3" class="text-center p-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>No categories found.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr class="bg-white">
                    <td class="fw-bold text-dark">@item.Name</td>
                    <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                    <td class="text-center">
                        <div class="btn-group shadow-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-secondary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger" title="Delete">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
