@model IEnumerable<PharmacyManagement.DAL.Data.Entities.UserActivity>
@{
    ViewData["Title"] = "User Login History";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-person-lines-fill"></i> User Login History</h2>
</div>

<div class="content-card">
    <table class="table table-pharmacy">
        <thead>
            <tr>
                <th>User</th>
                <th>Login Time</th>
                <th>Logout Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var act in Model)
            {
                <tr>
                    <td>@act.User?.UserName</td>
                    <td>@DateDisplayHelper.FormatShortDateTime(act.LoginTime)</td>
                    <td>@(act.LogoutTime.HasValue ? DateDisplayHelper.FormatShortDateTime(act.LogoutTime.Value) : "-")</td>
                    <td>
                        @if (act.IsSuccess)
                        {
                            <span class="badge bg-success">Success</span>
                            @if (act.LogoutTime == null)
                            {
                                <span class="badge bg-info">Active</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-danger" title="@act.FailureReason">Failed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
