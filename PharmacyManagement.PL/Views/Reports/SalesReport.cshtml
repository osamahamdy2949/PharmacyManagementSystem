@model IEnumerable<SalesReportItemViewModel>
@{ ViewData["Title"] = "Sales Report"; }
<h2>Sales Report</h2>
<div class="mb-3">
    <a asp-action="ExportSalesExcel" asp-route-period="@ViewBag.Period" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Export Excel</a>
    <a asp-action="ExportSalesPdf" asp-route-period="@ViewBag.Period" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> Export PDF</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Invoice</th><th>Date</th><th>Customer</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr><td>#@s.InvoiceId</td><td>@s.InvoiceDate.ToShortDateString()</td><td>@s.CustomerName</td><td>@DisplayHelpers.Egp(s.TotalAmount)</td></tr>
    }
    </tbody>
</table>
