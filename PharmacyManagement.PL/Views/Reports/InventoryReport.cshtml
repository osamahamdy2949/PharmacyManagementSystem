@model IEnumerable<InventoryReportItemViewModel>
@{ ViewData["Title"] = "Inventory Report"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-seam"></i> Inventory Report</h2>
    <div>
        <a asp-action="ExportInventoryExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Export Excel</a>
        <a asp-action="ExportInventoryPdf" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> Export PDF</a>
    </div>
</div>
<div class="content-card">
    <table class="table table-pharmacy">
        <thead><tr><th>Medicine</th><th>Category</th><th>Stock</th><th>Expiry</th><th>Price (EGP)</th></tr></thead>
        <tbody>
        @foreach (var m in Model)
        {
            var rowClass = m.ExpiryDate <= DateTime.Today.AddDays(ValidationConstants.NearExpiryDays)
                ? "row-near-expiry"
                : m.QuantityInStock < ValidationConstants.LowStockThreshold ? "row-low-stock" : "";
            <tr class="@rowClass">
                <td>@m.TradeName</td><td>@m.CategoryName</td><td>@m.QuantityInStock</td>
                <td>@m.ExpiryDate.ToShortDateString()</td><td>@DisplayHelpers.Egp(m.SellingPrice)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
