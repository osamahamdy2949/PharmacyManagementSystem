@using PharmacyManagement.DAL.Common
@model IEnumerable<CustomerViewModel>
@{
    ViewData["Title"] = "Customers";
    ViewData["PageTitle"] = "Customers Directory";
    ViewData["PageIcon"] = "bi-people";
    var canManage = User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.Pharmacist);
    if (canManage)
    {
        ViewData["AddUrl"] = Url.Action("Create");
        ViewData["AddText"] = "Add Customer";
    }
}
<partial name="_PageHeader" />

<div class="content-card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-enterprise mb-0">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Phone Number</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="3" class="text-center p-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>No customers found.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr class="bg-white">
                    <td class="fw-bold text-dark">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 border text-primary fw-bold" style="width: 32px; height: 32px;">
                                @(string.IsNullOrWhiteSpace(c.Name) ? "?" : c.Name.Substring(0, 1).ToUpper())
                            </div>
                            @c.Name
                        </div>
                    </td>
                    <td>
                        @if (c.PhoneDisplay != "N/A")
                        {
                            <a href="tel:@c.PhoneDisplay" class="text-decoration-none text-muted"><i class="bi bi-telephone me-1"></i> @c.PhoneDisplay</a>
                        }
                        else
                        {
                            <span class="text-muted opacity-50">N/A</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group shadow-sm">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-light border text-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (canManage)
                            {
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light border text-secondary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-light border text-danger" title="Delete">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
