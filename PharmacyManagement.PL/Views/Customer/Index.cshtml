@using PharmacyManagement.DAL.Common
@model IEnumerable<CustomerViewModel>
@{
    ViewData["Title"] = "Customers";
    ViewData["PageTitle"] = "Customers";
    ViewData["AddUrl"] = Url.Action("Create");
    ViewData["AddText"] = "Add Customer";
    var canManage = User.IsInRole(RoleNames.Administrator) || User.IsInRole(RoleNames.Pharmacist);
}
<partial name="_PageHeader" />
<div class="content-card">
<table class="table table-pharmacy table-striped">
    <thead><tr><th>Name</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td><td>@c.PhoneDisplay</td>
            <td>
                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">Details</a>
                @if (canManage)
                {
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
