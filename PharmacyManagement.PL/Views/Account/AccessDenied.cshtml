@{ ViewData["Title"] = "Access Denied"; }
<div class="content-card text-center py-5">
    <i class="bi bi-shield-lock display-1 text-danger"></i>
    <h2 class="mt-3">Access Denied</h2>
    <p class="text-muted">You do not have permission to access this page.</p>
    @if (!string.IsNullOrWhiteSpace(ViewData["ReturnUrl"]?.ToString()))
    {
        <p class="small text-muted mb-4">Requested URL: @ViewData["ReturnUrl"]</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-pharmacy">Back to Dashboard</a>
</div>
