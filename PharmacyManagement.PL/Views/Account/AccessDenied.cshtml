@{ 
    ViewData["Title"] = "Access Denied"; 
    ViewData["PageTitle"] = "Restricted Area";
}
<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="content-card shadow-lg border-0 border-top border-danger border-4 p-5" style="border-radius: 1rem;">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 100px; height: 100px; font-size: 3rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>
            <h2 class="fw-bold text-dark mb-3">Access Denied</h2>
            <p class="text-muted fs-5 mb-4">You do not have the required permissions to access this page or perform this action.</p>
            
            @if (!string.IsNullOrWhiteSpace(ViewData["ReturnUrl"]?.ToString()))
            {
                <div class="bg-light rounded p-2 mb-4 d-inline-block border">
                    <p class="small text-muted mb-0 font-monospace text-break"><code>@ViewData["ReturnUrl"]</code></p>
                </div>
            }
            
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm rounded-pill">
                    <i class="bi bi-house-door me-2"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
