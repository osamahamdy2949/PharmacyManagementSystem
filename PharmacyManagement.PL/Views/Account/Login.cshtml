@model PharmacyManagement.PL.Controllers.LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Pharmacy Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="content-card shadow">
                    <div class="text-center mb-4">
                        <img src="~/images/pharmacy-icon.svg" alt="" width="48" height="48" />
                        <h3 class="mt-2">Pharmacy Management</h3>
                        <p class="text-muted">Sign in to continue</p>
                    </div>
                    <form asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <div class="form-field mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <span asp-validation-for="Email" class="field-error"></span>
                            <input asp-for="Email" class="form-control" autocomplete="username" />
                        </div>
                        <div class="form-field mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <partial name="_ModelLevelErrors" />
                            <span asp-validation-for="Password" class="field-error"></span>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <button type="submit" class="btn btn-pharmacy w-100">Sign In</button>
                    </form>
                    <div class="mt-4 small text-muted">
                        <p class="mb-1"><strong>Demo accounts:</strong></p>
                        <p class="mb-0">Admin: admin@pharmacy.com / Admin@123</p>
                        <p class="mb-0">Pharmacist: pharmacist@pharmacy.com / Pharma@123</p>
                        <p class="mb-0">Cashier: cashier@pharmacy.com / Cashier@123</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
