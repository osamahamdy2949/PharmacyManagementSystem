@model PharmacyManagement.PL.Controllers.LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Pharmacy Management System</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script>
        (() => {
            const theme = localStorage.getItem('pms-theme') || 'light';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0; height: 100%;
            font-family: 'Inter', system-ui, sans-serif;
        }

        .login-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ─── Left Panel: Photo ─── */
        .login-photo {
            flex: 1;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3rem;
        }
        .login-photo-bg {
            position: absolute;
            inset: 0;
            background-image: url('/images/login-bg.png');
            background-size: cover;
            background-position: center;
            transform: scale(1.05);
            transition: transform 8s ease;
        }
        .login-photo:hover .login-photo-bg { transform: scale(1.0); }
        .login-photo-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(8, 15, 40, 0.92) 0%,
                rgba(8, 15, 40, 0.4) 50%,
                rgba(8, 15, 40, 0.1) 100%
            );
        }
        .login-photo-content {
            position: relative;
            z-index: 2;
        }
        .login-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(99, 102, 241, 0.25);
            border: 1px solid rgba(99, 102, 241, 0.5);
            backdrop-filter: blur(8px);
            color: #A5B4FC;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.4rem 1rem;
            border-radius: 100px;
            margin-bottom: 1.25rem;
        }
        .login-photo-title {
            font-size: clamp(1.75rem, 3vw, 2.5rem);
            font-weight: 800;
            color: #ffffff;
            line-height: 1.2;
            margin-bottom: 0.75rem;
        }
        .login-photo-subtitle {
            font-size: 1rem;
            color: rgba(255,255,255,0.65);
            font-weight: 400;
            max-width: 420px;
        }
        .login-stats {
            display: flex;
            gap: 2rem;
            margin-top: 2rem;
        }
        .login-stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1;
        }
        .login-stat-label {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.55);
            margin-top: 0.25rem;
        }

        /* ─── Right Panel: Form ─── */
        .login-form-panel {
            width: 480px;
            flex-shrink: 0;
            background: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 3.5rem;
            overflow-y: auto;
        }
        [data-theme="dark"] .login-form-panel {
            background: #0F172A;
        }

        .login-logo-wrap {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 2.75rem;
        }
        .login-logo-img {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
        }
        .login-logo-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0F172A;
        }
        [data-theme="dark"] .login-logo-name { color: #F1F5F9; }
        .login-logo-tag {
            font-size: 0.7rem;
            color: #94A3B8;
            font-weight: 500;
            letter-spacing: 0.04em;
        }

        .login-heading { font-size: 1.75rem; font-weight: 800; color: #0F172A; margin-bottom: 0.35rem; }
        [data-theme="dark"] .login-heading { color: #F1F5F9; }
        .login-subheading { font-size: 0.9rem; color: #64748B; margin-bottom: 2.25rem; }

        .login-input-group { margin-bottom: 1.1rem; }
        .login-input-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.4rem;
            letter-spacing: 0.02em;
        }
        [data-theme="dark"] .login-input-label { color: #CBD5E1; }
        .login-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: #0F172A;
            background: #F8FAFC;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }
        [data-theme="dark"] .login-input {
            background: #1E293B;
            border-color: #334155;
            color: #F1F5F9;
        }
        .login-input:focus {
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
            background: #FFFFFF;
        }
        [data-theme="dark"] .login-input:focus { background: #1E293B; }
        .login-input::placeholder { color: #94A3B8; }

        .login-btn {
            width: 100%;
            padding: 0.85rem;
            background: linear-gradient(135deg, #4F46E5, #6366F1);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            margin-top: 0.5rem;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .login-btn:hover {
            background: linear-gradient(135deg, #4338CA, #4F46E5);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.55);
            transform: translateY(-1px);
        }
        .login-btn:active { transform: translateY(0); }

        .login-divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 1.5rem 0;
            color: #CBD5E1;
            font-size: 0.8rem;
        }
        .login-divider::before,
        .login-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #E2E8F0;
        }
        [data-theme="dark"] .login-divider::before,
        [data-theme="dark"] .login-divider::after { background: #334155; }

        .demo-creds {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            padding: 1rem;
        }
        [data-theme="dark"] .demo-creds { background: #1E293B; border-color: #334155; }
        .demo-creds-title {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #94A3B8;
            margin-bottom: 0.6rem;
        }
        .demo-cred-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            color: #475569;
            padding: 0.25rem 0;
        }
        [data-theme="dark"] .demo-cred-item { color: #94A3B8; }
        .demo-cred-role {
            background: #EEF2FF;
            color: #4F46E5;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            letter-spacing: 0.04em;
        }

        .theme-btn {
            position: fixed;
            top: 1.25rem;
            right: 1.25rem;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid #E2E8F0;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #475569;
            font-size: 1rem;
            z-index: 100;
            transition: all 0.2s;
        }
        .theme-btn:hover { background: #F1F5F9; border-color: #CBD5E1; }
        [data-theme="dark"] .theme-btn { background: rgba(15,23,42,0.9); border-color: #334155; color: #94A3B8; }

        @@media (max-width: 900px) {
            .login-photo { display: none; }
            .login-form-panel { width: 100%; padding: 2rem 1.5rem; }
        }

        .field-error { color: #EF4444; font-size: 0.78rem; display: block; margin-top: 0.3rem; }
    </style>
</head>
<body>

    <button class="theme-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
        <i class="bi bi-moon-stars"></i>
    </button>

    <div class="login-shell">
        <!-- Left: Form Panel -->
        <div class="login-form-panel">
            <div class="login-logo-wrap">
                <img src="~/images/logo-3d.png" alt="Logo" class="login-logo-img" />
                <div>
                    <div class="login-logo-name">Pharmacy MS</div>
                    <div class="login-logo-tag">Management System</div>
                </div>
            </div>

            <h2 class="login-heading">Welcome back</h2>
            <p class="login-subheading">Sign in to your account to continue.</p>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <partial name="_ModelLevelErrors" />

                <div class="login-input-group">
                    <label class="login-input-label" asp-for="Email">Email address</label>
                    <input asp-for="Email" class="login-input" type="email" autocomplete="username" placeholder="admin@pharmacy.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="login-input-group">
                    <label class="login-input-label" asp-for="Password">Password</label>
                    <input asp-for="Password" class="login-input" type="password" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="login-btn">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
            </form>

            <div class="login-divider">Demo credentials</div>

            <div class="demo-creds">
                <div class="demo-creds-title">Quick Access Accounts</div>
                <div class="demo-cred-item">
                    <span class="demo-cred-role">ADMIN</span>
                    admin@pharmacy.com &nbsp;/&nbsp; Admin@123
                </div>
                <div class="demo-cred-item">
                    <span class="demo-cred-role" style="background:#ECFDF5;color:#059669;">RX</span>
                    pharmacist@pharmacy.com &nbsp;/&nbsp; Pharma@123
                </div>
                <div class="demo-cred-item">
                    <span class="demo-cred-role" style="background:#FFF7ED;color:#D97706;">POS</span>
                    cashier@pharmacy.com &nbsp;/&nbsp; Cashier@123
                </div>
            </div>
        </div>

        <!-- Right: Photo Panel -->
        <div class="login-photo">
            <div class="login-photo-bg"></div>
            <div class="login-photo-overlay"></div>
            <div class="login-photo-content">
                <div class="login-badge">
                    <i class="bi bi-shield-check"></i> Enterprise Pharmacy System
                </div>
                <h1 class="login-photo-title">One Platform.<br />Every Pharmacy Need.</h1>
                <p class="login-photo-subtitle">Manage sales, inventory, purchases, returns, and your entire team — all from a single, unified platform.</p>
                <div class="login-stats">
                    <div>
                        <div class="login-stat-value">99.9%</div>
                        <div class="login-stat-label">Uptime SLA</div>
                    </div>
                    <div>
                        <div class="login-stat-value">Real-time</div>
                        <div class="login-stat-label">Inventory Sync</div>
                    </div>
                    <div>
                        <div class="login-stat-value">Multi-role</div>
                        <div class="login-stat-label">Access Control</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
