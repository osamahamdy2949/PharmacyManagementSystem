@model PharmacyManagement.PL.Controllers.LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Pharmacy Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script>
        (() => {
            const theme = localStorage.getItem('pms-theme') || 'light';
            const lang = localStorage.getItem('pms-lang') || 'en';
            document.documentElement.dataset.theme = theme;
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page d-flex align-items-center min-vh-100">
    <div class="position-fixed top-0 end-0 p-3 theme-language-controls">
        <button type="button" class="btn btn-light shell-icon-btn" id="themeToggle" title="Toggle dark mode" aria-label="Toggle dark mode">
            <i class="bi bi-moon-stars"></i>
        </button>
        <button type="button" class="btn btn-light" id="languageToggle" title="Switch language" aria-label="Switch language">AR</button>
    </div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="content-card shadow">
                    <div class="text-center mb-4">
                        <img src="~/images/pharmacy-icon.svg" alt="" width="48" height="48" />
                        <h3 class="mt-2">Pharmacy Management</h3>
                        <p class="text-muted" data-i18n="login.continue">Sign in to continue</p>
                    </div>
                    <form asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <div class="form-field mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <span asp-validation-for="Email" class="field-error"></span>
                            <input asp-for="Email" class="form-control" autocomplete="username" />
                        </div>
                        <div class="form-field mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <partial name="_ModelLevelErrors" />
                            <span asp-validation-for="Password" class="field-error"></span>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        </div>
                        <button type="submit" class="btn btn-pharmacy w-100" data-i18n="login.signIn">Sign In</button>
                    </form>
                    <div class="mt-4 small text-muted">
                        <p class="mb-1"><strong data-i18n="login.demoAccounts">Demo accounts:</strong></p>
                        <p class="mb-0">Admin: admin@pharmacy.com / Admin@123</p>
                        <p class="mb-0">Pharmacist: pharmacist@pharmacy.com / Pharma@123</p>
                        <p class="mb-0">Cashier: cashier@pharmacy.com / Cashier@123</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
