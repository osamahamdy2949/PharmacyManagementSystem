@using PharmacyManagement.DAL.Data.Entities.Enums
@model PharmacyManagement.BLL.ViewModels.PurchaseReturnViewModels.CreatePurchaseReturnViewModel
@{ ViewData["Title"] = "Create Return"; ViewData["PageTitle"] = "New Purchase Return"; }
<div class="page-header mb-4 border-bottom pb-3">
    <h2 class="fw-bold text-primary"><i class="bi bi-arrow-return-left me-2 opacity-75"></i> New Purchase Return</h2>
    <p class="text-muted mb-0">Return items from Purchase Invoice #@Model.PurchaseInvoiceId to the supplier.</p>
</div>

<form asp-action="Create" method="post" class="content-card shadow-sm border-0 rounded-3 p-4">
    <input type="hidden" asp-for="PurchaseInvoiceId" />
    
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="ReturnDate" class="form-label fw-bold text-secondary small">Return Date</label>
            <input asp-for="ReturnDate" type="date" class="form-control" />
            <span asp-validation-for="ReturnDate" class="field-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Reason" class="form-label fw-bold text-secondary small">Reason</label>
            <select asp-for="Reason" asp-items="Html.GetEnumSelectList<PurchaseReturnReason>()" class="form-select">
                <option value="">-- Select Reason --</option>
            </select>
            <span asp-validation-for="Reason" class="field-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Notes" class="form-label fw-bold text-secondary small">Notes</label>
            <input asp-for="Notes" class="form-control" placeholder="Optional notes..." />
            <span asp-validation-for="Notes" class="field-error"></span>
        </div>
    </div>

    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Return Items</h5>
    <div class="table-responsive shadow-sm border rounded mb-4">
        <table class="table table-pharmacy mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Medicine</th>
                    <th>Batch #</th>
                    <th class="text-end">Unit Price</th>
                    <th style="width: 150px;">Return Qty</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Items[i].MedicineBatchId" />
                            <input type="hidden" asp-for="Items[i].MedicineId" />
                            <input type="hidden" asp-for="Items[i].UnitPrice" />
                            <input type="hidden" asp-for="Items[i].MaxQuantity" />
                            <span class="fw-bold text-dark">@Model.Items[i].MedicineName</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">@Model.Items[i].BatchNumber</span></td>
                        <td class="text-end">@DisplayHelpers.Egp(Model.Items[i].UnitPrice)</td>
                        <td>
                            <div class="input-group">
                                <input asp-for="Items[i].Quantity" class="form-control text-center fw-bold" min="0" max="@Model.Items[i].MaxQuantity" />
                                <span class="input-group-text bg-light text-muted" style="font-size: 0.8rem;">/ @Model.Items[i].MaxQuantity</span>
                            </div>
                            <span asp-validation-for="Items[i].Quantity" class="field-error d-block mt-1"></span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="PurchaseInvoice" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
        <button type="submit" class="btn btn-pharmacy px-5 shadow"><i class="bi bi-check-circle me-2"></i> Submit Return</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
