@model IEnumerable<PurchaseReturnListItemViewModel>
@using PharmacyManagement.BLL.ViewModels.PurchaseReturnViewModels
@{ 
    ViewData["Title"] = "Purchase Returns"; 
    ViewData["PageTitle"] = "Purchase Returns";
    ViewData["PageIcon"] = "bi-arrow-return-left";
}
<partial name="_PageHeader" />

<div class="content-card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-enterprise mb-0">
            <thead>
                <tr>
                    <th>Return #</th>
                    <th>Orig. Invoice #</th>
                    <th>Supplier Name</th>
                    <th>Date & Time</th>
                    <th>Reason</th>
                    <th class="text-end">Total Refunded</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="7" class="text-center p-5 text-muted"><i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>No purchase returns found.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-bold text-dark">#@r.Id</td>
                    <td><a asp-controller="PurchaseInvoice" asp-action="Details" asp-route-id="@r.PurchaseInvoiceId" class="text-decoration-none fw-bold">#@r.PurchaseInvoiceId</a></td>
                    <td>
                        <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-truck me-1"></i> @r.SupplierName</span>
                    </td>
                    <td>
                        <span class="d-block text-dark fw-medium">@DisplayHelpers.Date(r.ReturnDate)</span>
                        <small class="text-muted">@r.ReturnDate.ToString("t")</small>
                    </td>
                    <td class="text-muted">@r.Reason</td>
                    <td class="text-end fw-bold text-danger">@DisplayHelpers.Egp(r.TotalAmount)</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-light border shadow-sm text-primary" title="View Details">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
