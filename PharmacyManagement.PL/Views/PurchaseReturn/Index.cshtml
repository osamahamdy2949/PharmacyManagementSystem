@model IEnumerable<PurchaseReturnListItemViewModel>
@using PharmacyManagement.BLL.ViewModels.PurchaseReturnViewModels
@{ ViewData["Title"] = "Purchase Returns"; }
<div class="page-header"><h2><i class="bi bi-arrow-return-right"></i> Purchase Returns</h2></div>
<div class="content-card">
<table class="table table-pharmacy table-striped">
    <thead><tr><th>#</th><th>Invoice</th><th>Supplier</th><th>Date</th><th>Reason</th><th>Amount</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Id</td>
            <td>@r.PurchaseInvoiceId</td>
            <td>@r.SupplierName</td>
            <td>@DisplayHelpers.Date(r.ReturnDate)</td>
            <td>@r.Reason</td>
            <td>@DisplayHelpers.Egp(r.TotalAmount)</td>
            <td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info">Details</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
