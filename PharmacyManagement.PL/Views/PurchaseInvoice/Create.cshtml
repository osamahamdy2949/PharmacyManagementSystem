@model CreatePurchaseInvoiceViewModel
@{ ViewData["Title"] = "Create Purchase"; ViewData["PageTitle"] = "New Purchase"; }
<partial name="_PageHeader" />

<div class="content-card shadow-sm border-0 rounded-3 p-4">
<form asp-action="Create" method="post">
    <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info-emphasis d-flex align-items-center mb-4">
        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
        <span>New stock is created as <strong>inactive</strong>. Activate it from the Purchases screen after entering barcode, expiry, and prices.</span>
    </div>
    <div class="row mb-4">
        <div class="col-md-6 form-field">
            <label asp-for="SupplierId" class="form-label fw-bold text-secondary">Supplier</label>
            <span asp-validation-for="SupplierId" class="field-error"></span>
            <select asp-for="SupplierId" asp-items="ViewBag.SupplierId" class="form-select border-primary-subtle shadow-none">
                <option value="">-- Select supplier --</option>
            </select>
        </div>
        <div class="col-md-6 form-field">
            <label asp-for="InvoiceDate" class="form-label fw-bold text-secondary"></label>
            <span asp-validation-for="InvoiceDate" class="field-error"></span>
            <input asp-for="InvoiceDate" type="date" class="form-control border-primary-subtle shadow-none" />
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-card-list me-2"></i>Line Items</h5>
            <span asp-validation-for="Items" class="field-error"></span>
            <partial name="_ModelLevelErrors" />
        </div>
        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" id="addLineBtn">
            <i class="bi bi-plus-circle me-1"></i> Add line
        </button>
    </div>
    <div id="lineItems">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <partial name="_PurchaseLineItem" view-data='new ViewDataDictionary(ViewData) { { "Index", i } }' />
        }
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <button type="submit" class="btn btn-pharmacy px-4 py-2 fw-bold shadow-sm"><i class="bi bi-check-circle me-2"></i>Create Purchase</button>
        <a asp-action="Index" class="btn btn-light border px-4 py-2 text-secondary fw-bold shadow-sm">Cancel</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let lineIndex = @Model.Items.Count;

        document.getElementById('addLineBtn').addEventListener('click', () => {
            const first = document.querySelector('.line-item');
            if (!first) return;
            const clone = first.cloneNode(true);
            clone.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/\[\d+\]/, `[${lineIndex}]`);
                el.id = (el.id || '').replace(/_\d+_/, `_${lineIndex}_`);
                if (el.tagName === 'SELECT' && el.classList.contains('medicine-select')) el.selectedIndex = 0;
                if (el.type === 'number' && el.name.includes('Quantity')) el.value = '1';
                else if (el.type === 'number' && el.name.includes('DoseValue')) el.value = '';
                else if (el.tagName === 'SELECT' && el.classList.contains('dose-unit')) el.selectedIndex = 0;
            });
            clone.querySelectorAll('.field-error').forEach(el => el.textContent = '');
            document.getElementById('lineItems').appendChild(clone);
            lineIndex++;
        });

        document.getElementById('lineItems').addEventListener('click', e => {
            if (e.target.closest('.remove-line') && document.querySelectorAll('.line-item').length > 1)
                e.target.closest('.line-item').remove();
        });
    </script>
}
