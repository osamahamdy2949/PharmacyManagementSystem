@model PosPageViewModel
@{ ViewData["Title"] = "New Sale"; ViewData["PageTitle"] = "Point of Sale"; }
<div class="page-header mb-4 border-bottom pb-3">
    <h2 class="fw-bold text-primary"><i class="bi bi-cart-plus-fill me-2 opacity-75"></i> Point of Sale</h2>
    <p class="text-muted mb-0">Quickly add medicines and checkout customers.</p>
</div>
@Html.AntiForgeryToken()

<div class="row g-4">
    <!-- Left Column: Search & Add -->
    <div class="col-lg-5">
        <div class="content-card h-100 d-flex flex-column">
            <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-search me-2"></i> Find Medicine</h5>
            <div class="position-relative mb-3">
                <input type="search" id="medicineSearch" class="form-control form-control-lg border-primary shadow-sm" placeholder="Scan barcode or type name..." style="padding-left: 2.5rem; border-width: 2px;" autocomplete="off" />
                <i class="bi bi-upc-scan position-absolute text-muted fs-4" style="top: 50%; transform: translateY(-50%); left: 12px;"></i>
            </div>
            
            <div id="searchResults" class="list-group mb-3 border-0 shadow-sm" style="max-height: 250px; overflow-y: auto;"></div>
            
            <div id="addPanel" class="mt-auto border rounded-3 p-4 bg-light shadow-sm d-none position-relative overflow-hidden">
                <div class="position-absolute top-0 start-0 w-100 bg-primary" style="height: 4px;"></div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark" id="selName"></h4>
                        <span class="badge bg-secondary mb-2" id="selDose"></span>
                    </div>
                </div>
                <p class="small text-muted mb-3" id="selMeta"></p>
                
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold text-secondary small">Quantity (<span id="selUnit"></span>)</label>
                        <input type="number" id="selQty" class="form-control form-control-lg fw-bold text-center" min="1" value="1" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold text-secondary small">Unit Price</label>
                        <input type="text" id="selPrice" class="form-control form-control-lg fw-bold text-center bg-white" readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold text-secondary small">Batch <small class="fw-normal text-muted">(leave empty for FEFO)</small></label>
                        <select id="selBatch" class="form-select border-secondary-subtle">
                            <option value="">FEFO — auto oldest expiry</option>
                        </select>
                    </div>
                </div>
                <div id="addError" class="text-danger small fw-bold mt-1 mb-2"></div>
                <button type="button" id="addToCartBtn" class="btn btn-pharmacy btn-lg w-100 shadow-sm"><i class="bi bi-cart-plus me-2"></i> Add to Invoice</button>
            </div>
        </div>
    </div>

    <!-- Right Column: Cart & Checkout -->
    <div class="col-lg-7">
        <div class="content-card d-flex flex-column h-100">
            <!-- Customer Details -->
            <div class="bg-light rounded-3 p-3 mb-4 border border-secondary-subtle">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary small">Existing Customer</label>
                        <select id="customerId" class="form-select shadow-none">
                            <option value="">-- New Customer --</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-secondary small">Invoice Date</label>
                        <input type="date" id="invoiceDate" class="form-control shadow-none" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small">Customer Name</label>
                        <input type="text" id="customerName" class="form-control shadow-none" placeholder="Required if new" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small">Phone</label>
                        <input type="text" id="customerPhone" class="form-control shadow-none" placeholder="Optional" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small">Doctor Name</label>
                        <input type="text" id="doctorName" class="form-control shadow-none" placeholder="Optional" />
                    </div>
                    <div class="col-12"><div id="customerError" class="text-danger small fw-bold mt-1"></div></div>
                </div>
            </div>

            <!-- Cart Table -->
            <div class="d-flex justify-content-between align-items-end mb-2">
                <h5 class="fw-bold text-secondary mb-0"><i class="bi bi-receipt me-2"></i> Current Invoice</h5>
                <span class="badge bg-primary rounded-pill fs-6 px-3 py-2"><span id="itemCount">0</span> items</span>
            </div>
            
            <div class="table-responsive flex-grow-1 mb-4 shadow-sm border rounded" style="min-height: 250px;">
                <table class="table table-pharmacy table-hover mb-0" id="cartTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Medicine</th>
                            <th>Dose</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody"></tbody>
                </table>
                <div id="cartEmpty" class="text-center text-muted p-5 w-100">
                    <i class="bi bi-cart-x fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-0 fw-medium">No items yet. Search and add medicines.</p>
                </div>
            </div>

            <!-- Checkout Area -->
            <div class="mt-auto bg-white rounded-3 p-4 border shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted text-uppercase fw-bold letter-spacing-1 small d-block mb-1">Grand Total</span>
                        <h2 class="mb-0 fw-bold text-primary" id="invoiceTotal">0.00 L.E</h2>
                    </div>
                    <button type="button" id="checkoutBtn" class="btn btn-pharmacy btn-lg px-5 shadow" disabled>
                        <i class="bi bi-check-circle-fill me-2"></i> Complete Sale
                    </button>
                </div>
                <div id="checkoutError" class="alert alert-danger mt-3 mb-0 d-none border-0 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i><span class="msg"></span></div>
                <div id="checkoutSuccess" class="alert alert-success mt-3 mb-0 d-none border-0 shadow-sm"><i class="bi bi-check-circle-fill me-2"></i><span class="msg"></span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selected = null;
    let cart = [];
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    function formatMoney(n) { return Number(n).toFixed(2) + ' L.E'; }
    function cartKey(item) { return `${item.medicineId}|${item.dose}|${item.batchId || ''}`; }

    function renderCart() {
        const body = document.getElementById('cartBody');
        body.innerHTML = '';
        let total = 0;
        cart.forEach((item, idx) => {
            total += item.subtotal;
            body.innerHTML += `<tr>
                <td><span class="fw-bold text-dark">${item.medicineName}</span><br><small class="text-muted">${item.serialNumber}</small></td>
                <td><span class="badge bg-light text-dark border">${item.dose}</span></td>
                <td class="text-center fw-bold">${item.quantity} <small class="text-muted fw-normal">${item.saleUnit}</small></td>
                <td class="text-end">${formatMoney(item.unitPrice)}</td>
                <td class="text-end fw-bold text-primary">${formatMoney(item.subtotal)}</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width:28px;height:28px;" onclick="removeItem(${idx})"><i class="bi bi-x-lg" style="font-size:0.75rem;"></i></button></td>
            </tr>`;
        });
        document.getElementById('itemCount').textContent = cart.length;
        document.getElementById('invoiceTotal').textContent = formatMoney(total);
        document.getElementById('cartEmpty').style.display = cart.length ? 'none' : 'block';
        document.getElementById('checkoutBtn').disabled = cart.length === 0;
    }

    window.removeItem = function(idx) { cart.splice(idx, 1); renderCart(); };

    document.getElementById('medicineSearch').addEventListener('input', async (e) => {
        const q = e.target.value.trim();
        if (q.length < 1) { document.getElementById('searchResults').innerHTML = ''; return; }
        const res = await fetch(`@Url.Action("SearchMedicines")?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        const list = document.getElementById('searchResults');
        list.innerHTML = data.map(m => `
            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" data-id='${JSON.stringify(m).replace(/'/g, "&#39;")}'>
                <div>
                    <h6 class="mb-1 fw-bold text-dark">${m.tradeName} <span class="badge bg-light text-dark border ms-2">${m.dose}</span></h6>
                    <small class="text-muted">${m.medicineForm} · ${formatMoney(m.sellingPrice)}/${m.saleUnit}</small>
                </div>
                <span class="badge ${m.quantityInStock > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} rounded-pill">
                    Stock: ${m.quantityInStock}
                </span>
            </button>`).join('');
        list.querySelectorAll('button').forEach(btn => btn.addEventListener('click', () => {
            selectMedicine(JSON.parse(btn.dataset.id));
            document.getElementById('searchResults').innerHTML = '';
            document.getElementById('medicineSearch').value = '';
        }));
    });

    function selectMedicine(m) {
        selected = m;
        document.getElementById('addPanel').classList.remove('d-none');
        document.getElementById('selName').textContent = m.tradeName;
        document.getElementById('selDose').textContent = m.dose;
        document.getElementById('selMeta').textContent = `${m.medicineForm} · ${m.unitInfo} · In stock: ${m.quantityInStock} ${m.saleUnit}`;
        document.getElementById('selUnit').textContent = m.saleUnit;
        document.getElementById('selPrice').value = formatMoney(m.sellingPrice);
        document.getElementById('selQty').max = m.quantityInStock;
        const batchSel = document.getElementById('selBatch');
        batchSel.innerHTML = '<option value="">FEFO — auto oldest expiry</option>' +
            (m.batches || []).map(b => `<option value="${b.batchId}" data-price="${b.sellingPrice}" data-qty="${b.quantityInStock}">${b.batchNumber} — exp ${b.expiryDate.split('T')[0]} (${b.quantityInStock} ${m.saleUnit})</option>`).join('');
        batchSel.onchange = () => {
            const opt = batchSel.selectedOptions[0];
            if (opt && opt.value) {
                document.getElementById('selPrice').value = formatMoney(opt.dataset.price);
                document.getElementById('selQty').max = opt.dataset.qty;
            } else {
                document.getElementById('selPrice').value = formatMoney(m.sellingPrice);
                document.getElementById('selQty').max = m.quantityInStock;
            }
        };
        document.getElementById('addError').textContent = '';
        document.getElementById('selQty').focus();
        document.getElementById('selQty').select();
    }

    document.getElementById('addToCartBtn').addEventListener('click', () => {
        if (!selected) return;
        const qty = parseInt(document.getElementById('selQty').value, 10);
        const batchId = parseInt(document.getElementById('selBatch').value, 10) || null;
        const batchOpt = document.getElementById('selBatch').selectedOptions[0];
        const unitPrice = batchId && batchOpt ? parseFloat(batchOpt.dataset.price) : selected.sellingPrice;
        const maxStock = batchId && batchOpt ? parseInt(batchOpt.dataset.qty, 10) : selected.quantityInStock;
        const err = document.getElementById('addError');
        err.textContent = '';
        if (!qty || qty <= 0) { err.textContent = 'Quantity must be greater than zero.'; return; }
        if (qty > maxStock) {
            err.textContent = `Cannot sell ${qty}. Only ${maxStock} in stock.`;
            return;
        }
        const key = `${selected.id}|${selected.dose}|${batchId || ''}`;
        const existing = cart.find(c => cartKey(c) === key);
        const newTotal = (existing ? existing.quantity : 0) + qty;
        if (newTotal > maxStock) {
            err.textContent = `Total quantity (${newTotal}) exceeds stock (${maxStock}).`;
            return;
        }
        if (existing) {
            existing.quantity += qty;
            existing.subtotal = existing.quantity * existing.unitPrice;
        } else {
            cart.push({
                medicineId: selected.id,
                dose: selected.dose,
                batchId,
                medicineName: selected.tradeName,
                serialNumber: selected.serialNumber,
                saleUnit: selected.saleUnit,
                quantity: qty,
                unitPrice,
                subtotal: qty * unitPrice,
                availableStock: maxStock
            });
        }
        renderCart();
        document.getElementById('selQty').value = 1;
        document.getElementById('addPanel').classList.add('d-none');
        document.getElementById('medicineSearch').focus();
    });

    document.getElementById('checkoutBtn').addEventListener('click', async () => {
        document.getElementById('customerError').textContent = '';
        const errBox = document.getElementById('checkoutError');
        const okBox = document.getElementById('checkoutSuccess');
        errBox.classList.add('d-none');
        okBox.classList.add('d-none');

        const customerId = parseInt(document.getElementById('customerId').value, 10) || 0;
        const customerName = document.getElementById('customerName').value.trim();
        if (!customerId && !customerName) {
            document.getElementById('customerError').textContent = 'Select a customer or enter a customer name.';
            return;
        }

        const payload = {
            customerId,
            customerName,
            customerPhone: document.getElementById('customerPhone').value.trim(),
            doctorName: document.getElementById('doctorName').value.trim(),
            invoiceDate: document.getElementById('invoiceDate').value,
            items: cart.map(c => ({
                medicineId: c.medicineId,
                dose: c.dose,
                batchId: c.batchId,
                medicineName: c.medicineName,
                serialNumber: c.serialNumber,
                saleUnit: c.saleUnit,
                quantity: c.quantity,
                unitPrice: c.unitPrice
            }))
        };

        const res = await fetch('@Url.Action("Checkout")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
            errBox.querySelector('.msg').textContent = data.message || 'Checkout failed.';
            errBox.classList.remove('d-none');
            return;
        }
        okBox.querySelector('.msg').innerHTML = `Sale completed! Invoice #${data.invoiceId} · Total: ${formatMoney(data.total)} · <a href="${data.receiptUrl}" class="alert-link fw-bold text-decoration-underline ms-2">Download receipt PDF</a>`;
        okBox.classList.remove('d-none');
        cart = [];
        renderCart();
        document.getElementById('searchResults').innerHTML = '';
        document.getElementById('addPanel').classList.add('d-none');
        document.getElementById('medicineSearch').focus();
    });
</script>
}
