@model PosPageViewModel
@{ 
    ViewData["Title"] = "New Sale"; 
    ViewData["PageTitle"] = "Point of Sale"; 
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 text-dark"><i class="bi bi-shop me-2 text-primary"></i> Point of Sale</h2>
        <p class="text-muted mb-0">Search medicines, build cart, and process checkout.</p>
    </div>
</div>
@Html.AntiForgeryToken()

<div class="row g-4 h-100 pb-4">
    <!-- Left Area: Customer & Search -->
    <div class="col-xl-8 col-lg-7 d-flex flex-column gap-4">
        
        <!-- Customer Details Panel -->
        <div class="content-card p-4 border-top border-primary border-4 shadow-sm">
            <h6 class="text-uppercase fw-bold text-muted mb-3" style="font-size: 0.75rem; letter-spacing: 0.05em;">Transaction Details</h6>
            <div class="row g-3">
                <div class="col-md-4 form-floating">
                    <select id="customerId" class="form-select shadow-none border-primary-subtle">
                        <option value="">-- New Customer --</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <label for="customerId">Customer Account</label>
                </div>
                <div class="col-md-4 form-floating">
                    <input type="text" id="customerName" class="form-control shadow-none" placeholder="Required if new" />
                    <label for="customerName">Customer Name</label>
                </div>
                <div class="col-md-4 form-floating">
                    <input type="text" id="customerPhone" class="form-control shadow-none" placeholder="Optional" />
                    <label for="customerPhone">Phone Number</label>
                </div>
                <div class="col-md-3 form-floating">
                    <input type="date" id="invoiceDate" class="form-control shadow-none" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <label for="invoiceDate">Invoice Date</label>
                </div>
                <div class="col-md-3 form-floating">
                    <input type="text" id="doctorName" class="form-control shadow-none" placeholder="Optional" />
                    <label for="doctorName">Doctor Name</label>
                </div>
                <div class="col-md-3 form-floating">
                    <select id="saleType" class="form-select shadow-none border-warning-subtle">
                        <option value="0">Cash</option>
                        <option value="1">Credit</option>
                    </select>
                    <label for="saleType">Payment Method</label>
                </div>
                <div class="col-md-3 form-floating" id="paidAmountContainer" style="display: none;">
                    <input type="number" id="paidAmount" class="form-control shadow-none fw-bold text-success" step="0.01" min="0" value="0.00" />
                    <label for="paidAmount">Amount Paid</label>
                </div>
                <div class="col-12"><div id="customerError" class="text-danger small fw-bold"></div></div>
            </div>
        </div>

        <!-- Search & Add Panel -->
        <div class="content-card flex-grow-1 d-flex flex-column p-0 overflow-hidden shadow-sm">
            <div class="bg-light p-4 border-bottom">
                <div class="position-relative">
                    <input type="search" id="medicineSearch" class="form-control form-control-lg border-2 border-primary shadow-sm" placeholder="Scan barcode or search medicine name..." style="padding-left: 3rem; height: 3.5rem;" autocomplete="off" />
                    <i class="bi bi-upc-scan position-absolute text-muted" style="top: 50%; transform: translateY(-50%); left: 1rem; font-size: 1.25rem;"></i>
                </div>
            </div>
            
            <!-- Live Search Results -->
            <div id="searchResults" class="list-group list-group-flush border-0" style="max-height: 300px; overflow-y: auto;"></div>
            
            <!-- Item Configurator (Hidden by default) -->
            <div id="addPanel" class="p-4 bg-white d-none position-relative">
                <div class="position-absolute top-0 start-0 w-100 bg-primary" style="height: 4px;"></div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark" id="selName"></h4>
                        <span class="badge bg-secondary mb-2" id="selDose"></span>
                        <p class="small text-muted mb-0" id="selMeta"></p>
                    </div>
                </div>
                
                <div class="row g-3 align-items-end mt-2 mb-3">
                    <div class="col-md-3 form-floating">
                        <input type="number" id="selQty" class="form-control fw-bold text-center fs-5" min="1" value="1" />
                        <label for="selQty">Quantity (<span id="selUnit"></span>)</label>
                    </div>
                    <div class="col-md-3 form-floating">
                        <input type="text" id="selPrice" class="form-control fw-bold text-center bg-light" readonly />
                        <label for="selPrice">Unit Price</label>
                    </div>
                    <div class="col-md-6 form-floating">
                        <select id="selBatch" class="form-select border-secondary-subtle">
                            <option value="">FEFO — auto oldest expiry</option>
                        </select>
                        <label for="selBatch">Batch Selection</label>
                    </div>
                </div>
                <div id="addError" class="text-danger small fw-bold mb-3"></div>
                <div class="text-end">
                    <button type="button" class="btn btn-light me-2" onclick="document.getElementById('addPanel').classList.add('d-none'); document.getElementById('medicineSearch').focus();">Cancel</button>
                    <button type="button" id="addToCartBtn" class="btn btn-primary px-4 fw-bold shadow-sm"><i class="bi bi-plus-lg me-2"></i>Add to Cart</button>
                </div>
            </div>

            <!-- Empty state when no search -->
            <div id="searchEmptyState" class="text-center p-5 text-muted flex-grow-1 d-flex flex-column justify-content-center">
                <i class="bi bi-search fs-1 opacity-25 mb-3"></i>
                <h6>Ready to scan or search</h6>
                <p class="small mb-0">Use the search bar above to find products.</p>
            </div>
        </div>
    </div>

    <!-- Right Sidebar: Live Cart -->
    <div class="col-xl-4 col-lg-5">
        <div class="content-card d-flex flex-column p-0 h-100 shadow-lg border-0 overflow-hidden" style="position: sticky; top: 1rem; max-height: calc(100vh - 8rem);">
            
            <div class="bg-dark text-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cart3 me-2"></i> Current Order</h5>
                    <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold"><span id="itemCount">0</span> items</span>
                </div>
            </div>
            
            <div class="flex-grow-1 overflow-auto bg-light">
                <div class="table-responsive">
                    <table class="table table-enterprise mb-0" id="cartTable">
                        <tbody id="cartBody"></tbody>
                    </table>
                </div>
                <div id="cartEmpty" class="text-center text-muted p-5 w-100 h-100 flex-column justify-content-center align-items-center bg-white d-flex">
                    <i class="bi bi-cart-x fs-1 opacity-25 d-block mb-3"></i>
                    <p class="mb-0 fw-medium">Cart is empty.</p>
                </div>
            </div>

            <div class="bg-white p-4 border-top">
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <span class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 0.05em;">Total Due</span>
                    <h2 class="mb-0 fw-bold text-primary" id="invoiceTotal">0.00 L.E</h2>
                </div>
                
                <div id="checkoutError" class="alert alert-danger mb-3 d-none p-2 small"><i class="bi bi-exclamation-triangle-fill me-2"></i><span class="msg"></span></div>
                <div id="checkoutSuccess" class="alert alert-success mb-3 d-none p-2 small"><i class="bi bi-check-circle-fill me-2"></i><span class="msg"></span></div>
                
                <button type="button" id="checkoutBtn" class="btn btn-primary btn-lg w-100 py-3 shadow-sm fw-bold fs-5 d-flex justify-content-center align-items-center" disabled>
                    <i class="bi bi-credit-card me-2"></i> Pay & Complete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selected = null;
    let cart = [];
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    function formatMoney(n) { return Number(n).toFixed(2) + ' L.E'; }
    function cartKey(item) { return `${item.medicineId}|${item.dose}|${item.batchId || ''}`; }

    function renderCart() {
        const body = document.getElementById('cartBody');
        body.innerHTML = '';
        let total = 0;
        cart.forEach((item, idx) => {
            total += item.subtotal;
            body.innerHTML += `
            <tr class="bg-white">
                <td class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="fw-bold text-dark d-block text-truncate" style="max-width: 180px;">${item.medicineName}</span>
                        <button type="button" class="btn btn-link text-danger p-0 ms-2" onclick="removeItem(${idx})"><i class="bi bi-trash3-fill"></i></button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="badge bg-light text-dark border">${item.quantity} x ${formatMoney(item.unitPrice)}</span>
                        <span class="fw-bold text-primary">${formatMoney(item.subtotal)}</span>
                    </div>
                </td>
            </tr>`;
        });
        document.getElementById('itemCount').textContent = cart.length;
        document.getElementById('invoiceTotal').textContent = formatMoney(total);
        if (cart.length > 0) {
            document.getElementById('cartEmpty').classList.remove('d-flex');
            document.getElementById('cartEmpty').classList.add('d-none');
        } else {
            document.getElementById('cartEmpty').classList.remove('d-none');
            document.getElementById('cartEmpty').classList.add('d-flex');
        }
        document.getElementById('checkoutBtn').disabled = cart.length === 0;
    }

    window.removeItem = function(idx) { cart.splice(idx, 1); renderCart(); };

    document.getElementById('saleType').addEventListener('change', function() {
        document.getElementById('paidAmountContainer').style.display = (this.value === '1') ? 'block' : 'none';
    });

    document.getElementById('customerId').addEventListener('change', function() {
        const customerName = document.getElementById('customerName');
        if (this.value) {
            customerName.value = '';
            customerName.readOnly = true;
            customerName.placeholder = 'Existing customer selected';
        } else {
            customerName.readOnly = false;
            customerName.placeholder = 'Required if new';
        }
    });

    document.getElementById('medicineSearch').addEventListener('input', async (e) => {
        const q = e.target.value.trim();
        const emptyState = document.getElementById('searchEmptyState');
        const addPanel = document.getElementById('addPanel');
        
        if (q.length < 1) { 
            document.getElementById('searchResults').innerHTML = ''; 
            emptyState.classList.remove('d-none');
            return; 
        }
        
        emptyState.classList.add('d-none');
        addPanel.classList.add('d-none');

        const res = await fetch(`@Url.Action("SearchMedicines")?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        const list = document.getElementById('searchResults');
        list.innerHTML = data.map(m => `
            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 px-4 border-bottom" data-id='${JSON.stringify(m).replace(/'/g, "&#39;")}' style="transition: background-color 0.15s;">
                <div>
                    <h6 class="mb-1 fw-bold text-dark">${m.tradeName} <span class="badge bg-light text-dark border ms-2">${m.dose}</span></h6>
                    <small class="text-muted">${m.medicineForm} · ${formatMoney(m.sellingPrice)}/${m.saleUnit}</small>
                </div>
                <span class="badge ${m.quantityInStock > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'} rounded-pill px-3 py-2">
                    ${m.quantityInStock} in stock
                </span>
            </button>`).join('');
            
        list.querySelectorAll('button').forEach(btn => btn.addEventListener('click', () => {
            selectMedicine(JSON.parse(btn.dataset.id));
            document.getElementById('searchResults').innerHTML = '';
            document.getElementById('medicineSearch').value = '';
        }));
    });

    function selectMedicine(m) {
        selected = m;
        document.getElementById('searchEmptyState').classList.add('d-none');
        document.getElementById('addPanel').classList.remove('d-none');
        document.getElementById('selName').textContent = m.tradeName;
        document.getElementById('selDose').textContent = m.dose;
        document.getElementById('selMeta').textContent = `${m.medicineForm} · ${m.unitInfo} · In stock: ${m.quantityInStock} ${m.saleUnit}`;
        document.getElementById('selUnit').textContent = m.saleUnit;
        document.getElementById('selPrice').value = formatMoney(m.sellingPrice);
        document.getElementById('selQty').max = m.quantityInStock;
        
        const batchSel = document.getElementById('selBatch');
        batchSel.innerHTML = '<option value="">FEFO — auto oldest expiry</option>' +
            (m.batches || []).map(b => `<option value="${b.batchId}" data-price="${b.sellingPrice}" data-qty="${b.quantityInStock}">${b.batchNumber} — exp ${b.expiryDate.split('T')[0]} (${b.quantityInStock} ${m.saleUnit})</option>`).join('');
        
        batchSel.onchange = () => {
            const opt = batchSel.selectedOptions[0];
            if (opt && opt.value) {
                document.getElementById('selPrice').value = formatMoney(opt.dataset.price);
                document.getElementById('selQty').max = opt.dataset.qty;
            } else {
                document.getElementById('selPrice').value = formatMoney(m.sellingPrice);
                document.getElementById('selQty').max = m.quantityInStock;
            }
        };
        
        document.getElementById('addError').textContent = '';
        document.getElementById('selQty').focus();
        document.getElementById('selQty').select();
    }

    document.getElementById('addToCartBtn').addEventListener('click', () => {
        if (!selected) return;
        const qty = parseInt(document.getElementById('selQty').value, 10);
        const batchId = parseInt(document.getElementById('selBatch').value, 10) || null;
        const batchOpt = document.getElementById('selBatch').selectedOptions[0];
        const unitPrice = batchId && batchOpt ? parseFloat(batchOpt.dataset.price) : selected.sellingPrice;
        const maxStock = batchId && batchOpt ? parseInt(batchOpt.dataset.qty, 10) : selected.quantityInStock;
        const err = document.getElementById('addError');
        err.textContent = '';
        
        if (!qty || qty <= 0) { err.textContent = 'Quantity must be greater than zero.'; return; }
        if (qty > maxStock) {
            err.textContent = `Cannot sell ${qty}. Only ${maxStock} in stock.`;
            return;
        }
        
        const key = `${selected.id}|${selected.dose}|${batchId || ''}`;
        const existing = cart.find(c => cartKey(c) === key);
        const newTotal = (existing ? existing.quantity : 0) + qty;
        
        if (newTotal > maxStock) {
            err.textContent = `Total quantity (${newTotal}) exceeds stock (${maxStock}).`;
            return;
        }
        
        if (existing) {
            existing.quantity += qty;
            existing.subtotal = existing.quantity * existing.unitPrice;
        } else {
            cart.push({
                medicineId: selected.id,
                dose: selected.dose,
                batchId,
                medicineName: selected.tradeName,
                serialNumber: selected.serialNumber,
                saleUnit: selected.saleUnit,
                quantity: qty,
                unitPrice,
                subtotal: qty * unitPrice,
                availableStock: maxStock
            });
        }
        
        renderCart();
        document.getElementById('selQty').value = 1;
        document.getElementById('addPanel').classList.add('d-none');
        document.getElementById('searchEmptyState').classList.remove('d-none');
        document.getElementById('medicineSearch').focus();
    });

    document.getElementById('checkoutBtn').addEventListener('click', async () => {
        document.getElementById('customerError').textContent = '';
        const errBox = document.getElementById('checkoutError');
        const okBox = document.getElementById('checkoutSuccess');
        errBox.classList.add('d-none');
        okBox.classList.add('d-none');

        const customerId = parseInt(document.getElementById('customerId').value, 10) || 0;
        const customerName = document.getElementById('customerName').value.trim();
        if (!customerId && !customerName) {
            document.getElementById('customerError').textContent = 'Select a customer or enter a name.';
            return;
        }

        const saleType = parseInt(document.getElementById('saleType').value, 10);
        let paidAmount = cart.reduce((sum, item) => sum + item.subtotal, 0);
        if (saleType === 1) {
            paidAmount = parseFloat(document.getElementById('paidAmount').value) || 0;
        }

        const btn = document.getElementById('checkoutBtn');
        const originalBtnHTML = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';

        const payload = {
            customerId,
            customerName,
            customerPhone: document.getElementById('customerPhone').value.trim(),
            doctorName: document.getElementById('doctorName').value.trim(),
            invoiceDate: document.getElementById('invoiceDate').value,
            saleType,
            paidAmount,
            items: cart.map(c => ({
                medicineId: c.medicineId,
                dose: c.dose,
                batchId: c.batchId,
                medicineName: c.medicineName,
                serialNumber: c.serialNumber,
                saleUnit: c.saleUnit,
                quantity: c.quantity,
                unitPrice: c.unitPrice
            }))
        };

        try {
            const res = await fetch('@Url.Action("Checkout")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if (!res.ok || !data.success) {
                errBox.querySelector('.msg').textContent = data.message || 'Checkout failed.';
                errBox.classList.remove('d-none');
            } else {
                okBox.querySelector('.msg').innerHTML = `Success! Invoice #${data.invoiceId} <a href="${data.receiptUrl}" class="alert-link fw-bold text-decoration-underline ms-2">Download Receipt</a>`;
                okBox.classList.remove('d-none');
                cart = [];
                renderCart();
                document.getElementById('customerId').value = '';
                document.getElementById('customerName').value = '';
            }
        } catch(e) {
            errBox.querySelector('.msg').textContent = 'Network error during checkout.';
            errBox.classList.remove('d-none');
        } finally {
            btn.innerHTML = originalBtnHTML;
            if(cart.length > 0) btn.disabled = false;
        }
    });
</script>
}
