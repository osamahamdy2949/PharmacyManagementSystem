@model SalesInvoiceViewModel
@{ ViewData["Title"] = "Sales Invoice"; }
<div class="page-header d-flex justify-content-between align-items-center">
    <h2>Sales Invoice #@Model.Id</h2>
    <div>
        <a asp-controller="SalesReturn" asp-action="Create" asp-route-invoiceId="@Model.Id" class="btn btn-outline-warning"><i class="bi bi-arrow-return-left"></i> Create Return</a>
        <a asp-action="DownloadReceipt" asp-route-id="@Model.Id" class="btn btn-pharmacy"><i class="bi bi-file-pdf"></i> Download receipt</a>
    </div>
</div>
<p class="mb-4">
    <strong>Customer:</strong> @Model.CustomerName |
    <strong>Doctor:</strong> @(Model.DoctorName ?? "—") |
    <strong>Date:</strong> @DisplayHelpers.Date(Model.InvoiceDate) |
    <strong>Total:</strong> @DisplayHelpers.Egp(Model.TotalAmount)
    <br/>
    <strong>Type:</strong> @Model.SaleType |
    <strong>Status:</strong> <span class="badge bg-@(Model.PaymentStatus == "Paid" ? "success" : Model.PaymentStatus == "PartiallyPaid" ? "warning" : "danger")">@Model.PaymentStatus</span>
    @if (Model.SaleType == "Credit" && Model.PaymentStatus != "Paid")
    {
        <span> | <strong>Paid:</strong> @DisplayHelpers.Egp(Model.PaidAmount) | <strong class="text-danger">Remaining:</strong> @DisplayHelpers.Egp(Model.RemainingAmount)</span>
    }
</p>
<div class="content-card">
<table class="table table-pharmacy">
    <thead><tr><th>Medicine</th><th>Qty</th><th>Unit</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.MedicineName <small class="text-muted">@item.SerialNumber</small></td>
            <td>@item.Quantity</td><td>@item.UnitLabel</td>
            <td>@DisplayHelpers.Egp(item.UnitPrice)</td>
            <td>@DisplayHelpers.Egp(item.Subtotal)</td>
        </tr>
    }
    </tbody>
</table>
</div>
<a asp-action="Index" class="btn btn-secondary">Back</a>
