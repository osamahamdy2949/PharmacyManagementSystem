@model IEnumerable<ShiftViewModel>
@{ ViewData["Title"] = "Shift History"; ViewData["PageTitle"] = "Shift Records"; }

<div class="content-card mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">From Date</label>
            <input type="date" name="from" value="@ViewBag.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">To Date</label>
            <input type="date" name="to" value="@ViewBag.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-2"></i> Search</button>
        </div>
    </form>
</div>

<div class="content-card">
    <table class="table table-pharmacy table-striped">
        <thead>
            <tr>
                <th>Date / Time</th>
                <th>Cashier</th>
                <th>Status</th>
                <th>Sales</th>
                <th>Expected</th>
                <th>Actual</th>
                <th>Diff</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex flex-column">
                            <span>@DisplayHelpers.Date(s.StartTime)</span>
                            <small class="text-muted">@s.StartTime.ToString("t") - @(s.EndTime?.ToString("t") ?? "Now")</small>
                        </div>
                    </td>
                    <td><span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i> @s.UserName</span></td>
                    <td>
                        @if (s.IsActive)
                        {
                            <span class="badge bg-primary">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                    </td>
                    <td>@DisplayHelpers.Egp(s.TotalSales)</td>
                    <td>@DisplayHelpers.Egp(s.SystemExpectedCash)</td>
                    <td>
                        @if (s.ClosingCash.HasValue)
                        {
                            <span class="fw-bold text-dark">@DisplayHelpers.Egp(s.ClosingCash.Value)</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (s.CashDifference.HasValue)
                        {
                            if (Math.Abs(s.CashDifference.Value) < 0.01m)
                            {
                                <span class="badge bg-success-subtle text-success border border-success border-opacity-25"><i class="bi bi-check-circle me-1"></i> Match</span>
                            }
                            else if (s.CashDifference.Value > 0)
                            {
                                <span class="badge bg-info-subtle text-info border border-info border-opacity-25">+@DisplayHelpers.Egp(s.CashDifference.Value)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25">@DisplayHelpers.Egp(s.CashDifference.Value)</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
