@model ShiftSummaryViewModel
@{ 
    ViewData["Title"] = "Current Shift"; 
    ViewData["PageTitle"] = "Shift Dashboard"; 
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i> Active Shift Dashboard</h2>
        <p class="text-muted mb-0">Monitor real-time shift performance and financials.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="content-card h-100 bg-primary bg-gradient text-white border-0 shadow-lg position-relative overflow-hidden" style="border-radius: 1rem;">
            <!-- Decorative circle -->
            <div class="position-absolute bg-white rounded-circle opacity-10" style="width: 200px; height: 200px; top: -50px; right: -50px;"></div>
            
            <div class="d-flex justify-content-between align-items-center mb-4 position-relative">
                <h5 class="mb-0 text-white fw-bold"><i class="bi bi-person-badge me-2"></i> Cashier Profile</h5>
                <span class="badge bg-white text-primary rounded-pill px-3 shadow-sm">In Progress</span>
            </div>
            
            <div class="mb-4 position-relative">
                <p class="mb-1 text-white text-opacity-75 small text-uppercase letter-spacing-1">Current User</p>
                <h4 class="text-white mb-0 fw-bold">@Model.UserName</h4>
            </div>
            
            <div class="mb-4 position-relative">
                <p class="mb-1 text-white text-opacity-75 small text-uppercase letter-spacing-1">Started At</p>
                <h3 class="text-white mb-0 fw-bold">@Model.StartTime.ToString("h:mm tt")</h3>
                <p class="text-white text-opacity-75 small">@Model.StartTime.ToString("dd MMM yyyy")</p>
            </div>
            
            <div class="mt-auto pt-4 border-top border-white border-opacity-25 d-grid gap-3 position-relative">
                <a asp-controller="SalesInvoice" asp-action="Pos" class="btn btn-light fw-bold py-2 shadow-sm text-primary">
                    <i class="bi bi-cart-plus me-2"></i> Open POS Terminal
                </a>
                <a asp-action="End" class="btn btn-danger fw-bold py-2 shadow-sm border border-white border-opacity-50">
                    <i class="bi bi-stop-circle me-2"></i> End Shift Now
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="content-card h-100 border-0 shadow-sm d-flex flex-column" style="border-radius: 1rem;">
            <div class="d-flex align-items-center mb-4">
                <div class="rounded bg-primary-subtle text-primary p-2 me-3">
                    <i class="bi bi-calculator fs-4"></i>
                </div>
                <h5 class="mb-0 fw-bold">Financial Summary</h5>
            </div>
            
            <div class="bg-light rounded-3 p-4 mb-4 border d-flex justify-content-between align-items-center shadow-sm">
                <div>
                    <span class="text-muted d-block small fw-bold text-uppercase letter-spacing-1 mb-1">Expected Drawer Cash</span>
                    <span class="fs-1 text-dark fw-bold">@DisplayHelpers.Egp(Model.ExpectedCash)</span>
                </div>
                <div class="bg-white rounded-circle p-3 shadow-sm border">
                    <i class="bi bi-cash-stack fs-1 text-primary"></i>
                </div>
            </div>
            
            <h6 class="text-uppercase text-muted fw-bold small letter-spacing-1 mb-3">Activity Breakdown</h6>
            <div class="row g-3 text-center mb-4 flex-grow-1">
                <div class="col-md-4">
                    <div class="p-4 rounded-3 border h-100 bg-white shadow-sm">
                        <div class="text-success mb-2"><i class="bi bi-graph-up-arrow fs-3"></i></div>
                        <span class="text-muted d-block small mb-1 fw-bold">Cash Sales</span>
                        <span class="fw-bold fs-5 text-dark">@DisplayHelpers.Egp(Model.CashSales)</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 rounded-3 border h-100 bg-white shadow-sm">
                        <div class="text-info mb-2"><i class="bi bi-wallet2 fs-3"></i></div>
                        <span class="text-muted d-block small mb-1 fw-bold">Received Payments</span>
                        <span class="fw-bold fs-5 text-dark">@DisplayHelpers.Egp(Model.TotalPaymentsReceived)</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 rounded-3 border h-100 bg-white shadow-sm">
                        <div class="text-danger mb-2"><i class="bi bi-graph-down-arrow fs-3"></i></div>
                        <span class="text-muted d-block small mb-1 fw-bold">Purchases (Cash Out)</span>
                        <span class="fw-bold fs-5 text-dark">@DisplayHelpers.Egp(Model.TotalPurchases)</span>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning mb-0 border-0 shadow-sm d-flex align-items-center mt-auto">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <span class="small fw-medium">Note: Cash Expected does not include credit sales until payments are received.</span>
            </div>
        </div>
    </div>
</div>
