@model SearchResultsViewModel
@{ ViewData["Title"] = "Search"; }
<div class="page-header">
    <h2><i class="bi bi-search"></i> Search Results</h2>
</div>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <div class="content-card text-center text-muted py-5">
        <i class="bi bi-search display-4"></i>
        <p class="mt-3 mb-0">Use the search bar in the navigation to find medicines, categories, suppliers, and customers.</p>
    </div>
}
else
{
    <p class="text-muted">Results for: <strong>@Model.Query</strong></p>

    @if (Model.Medicines.Any())
    {
        <div class="content-card mb-3">
            <h5 class="text-teal"><i class="bi bi-capsule"></i> Medicines</h5>
            <table class="table table-pharmacy table-sm mb-0">
                <thead><tr><th>Name</th><th>Category</th><th>Stock</th><th>Price</th><th></th></tr></thead>
                <tbody>
                @foreach (var m in Model.Medicines)
                {
                    <tr class="@DisplayHelpers.MedicineRowClass(m)">
                        <td>@m.TradeName</td><td>@m.CategoryName</td><td>@m.QuantityInStock</td>
                        <td>@DisplayHelpers.Egp(m.SellingPrice)</td>
                        <td><a asp-controller="Medicine" asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Categories.Any())
    {
        <div class="content-card mb-3">
            <h5 class="text-teal"><i class="bi bi-tags"></i> Categories</h5>
            <ul class="list-group list-group-flush">
                @foreach (var c in Model.Categories)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        @c.Name <a asp-controller="Category" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-link">Edit</a>
                    </li>
                }
            </ul>
        </div>
    }

    @if (Model.Suppliers.Any())
    {
        <div class="content-card mb-3">
            <h5 class="text-teal"><i class="bi bi-truck"></i> Suppliers</h5>
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.Suppliers)
                {
                    <li class="list-group-item">@s.Name — @s.Email</li>
                }
            </ul>
        </div>
    }

    @if (Model.Customers.Any())
    {
        <div class="content-card mb-3">
            <h5 class="text-teal"><i class="bi bi-people"></i> Customers</h5>
            <ul class="list-group list-group-flush">
                @foreach (var c in Model.Customers)
                {
                    <li class="list-group-item">@c.Name — @c.Phone</li>
                }
            </ul>
        </div>
    }

    @if (!Model.Medicines.Any() && !Model.Categories.Any() && !Model.Suppliers.Any() && !Model.Customers.Any())
    {
        <div class="alert alert-info">No results found for your search.</div>
    }
}
