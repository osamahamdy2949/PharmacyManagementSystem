@model PharmacyManagement.BLL.ViewModels.DashboardViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Overview";
}

<!-- KPI Cards - Today -->
<h6 class="text-muted mb-3 text-uppercase fw-bold">Today's Performance</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-primary border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Today's Sales</h6>
                    <h3 class="mb-0 text-primary">@DisplayHelpers.Egp(Model.TodaySales)</h3>
                </div>
                <div class="icon-circle bg-primary-subtle text-primary"><i class="bi bi-cart-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-danger border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Today's Purchases</h6>
                    <h3 class="mb-0 text-danger">@DisplayHelpers.Egp(Model.TodayPurchases)</h3>
                </div>
                <div class="icon-circle bg-danger-subtle text-danger"><i class="bi bi-bag-plus"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-success border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Today's Profit</h6>
                    <h3 class="mb-0 text-success">@DisplayHelpers.Egp(Model.TodayProfit)</h3>
                </div>
                <div class="icon-circle bg-success-subtle text-success"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards - Monthly -->
<h6 class="text-muted mb-3 text-uppercase fw-bold">Monthly Performance</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-primary border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Monthly Sales</h6>
                    <h3 class="mb-0 text-primary">@DisplayHelpers.Egp(Model.MonthlySales)</h3>
                </div>
                <div class="icon-circle bg-primary-subtle text-primary"><i class="bi bi-calendar-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-danger border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Monthly Purchases</h6>
                    <h3 class="mb-0 text-danger">@DisplayHelpers.Egp(Model.MonthlyPurchases)</h3>
                </div>
                <div class="icon-circle bg-danger-subtle text-danger"><i class="bi bi-calendar-minus"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-success border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Monthly Profit</h6>
                    <h3 class="mb-0 text-success">@DisplayHelpers.Egp(Model.MonthlyProfit)</h3>
                </div>
                <div class="icon-circle bg-success-subtle text-success"><i class="bi bi-calendar2-check"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards - Entities -->
<h6 class="text-muted mb-3 text-uppercase fw-bold">Overview</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-warning border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Outstanding Debt</h6>
                    <h3 class="mb-0 text-warning">@DisplayHelpers.Egp(Model.OutstandingDebt)</h3>
                </div>
                <div class="icon-circle bg-warning-subtle text-warning"><i class="bi bi-exclamation-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-info border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Total Customers</h6>
                    <h3 class="mb-0 text-info">@Model.TotalCustomers</h3>
                </div>
                <div class="icon-circle bg-info-subtle text-info"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-12">
        <div class="content-card border-start border-secondary border-4 h-100 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase small fw-bold">Total Products</h6>
                    <h3 class="mb-0 text-secondary">@Model.TotalProducts</h3>
                </div>
                <div class="icon-circle bg-secondary-subtle text-secondary"><i class="bi bi-box"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
<div class="row g-3 mb-4">
    @if (Model.LowStockItems > 0)
    {
        <div class="col-md-3 col-sm-6">
            <div class="alert alert-danger border-danger border-opacity-50 shadow-sm d-flex flex-column align-items-center mb-0 p-3 text-center">
                <i class="bi bi-exclamation-octagon-fill fs-2 text-danger mb-2"></i>
                <h6 class="alert-heading fw-bold mb-1">Low Stock Items</h6>
                <h4 class="mb-0 text-danger fw-bold">@Model.LowStockItems</h4>
            </div>
        </div>
    }
    @if (Model.NearLowStockItems > 0)
    {
        <div class="col-md-3 col-sm-6">
            <div class="alert alert-warning border-warning border-opacity-50 shadow-sm d-flex flex-column align-items-center mb-0 p-3 text-center">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning mb-2"></i>
                <h6 class="alert-heading fw-bold mb-1">Near Low Stock</h6>
                <h4 class="mb-0 text-warning fw-bold">@Model.NearLowStockItems</h4>
            </div>
        </div>
    }
    @if (Model.ExpiringMedicines > 0)
    {
        <div class="col-md-3 col-sm-6">
            <div class="alert alert-danger border-danger border-opacity-50 shadow-sm d-flex flex-column align-items-center mb-0 p-3 text-center">
                <i class="bi bi-calendar-x-fill fs-2 text-danger mb-2"></i>
                <h6 class="alert-heading fw-bold mb-1">Expired Medicines</h6>
                <h4 class="mb-0 text-danger fw-bold">@Model.ExpiringMedicines</h4>
            </div>
        </div>
    }
    @if (Model.NearExpiringMedicines > 0)
    {
        <div class="col-md-3 col-sm-6">
            <div class="alert alert-warning border-warning border-opacity-50 shadow-sm d-flex flex-column align-items-center mb-0 p-3 text-center">
                <i class="bi bi-calendar-event fs-2 text-warning mb-2"></i>
                <h6 class="alert-heading fw-bold mb-1">Near Expiring</h6>
                <h4 class="mb-0 text-warning fw-bold">@Model.NearExpiringMedicines</h4>
            </div>
        </div>
    }
</div>

<!-- Main Dashboard Content -->
<div class="row">
    <!-- Charts Column -->
    <div class="col-lg-8">
        <!-- Sales Trend Chart -->
        <div class="content-card mb-4">
            <h5 class="mb-4">Sales Trend (Last 7 Days)</h5>
            <div style="height: 300px;">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>

        <!-- Removed Top Selling Medicines -->
    </div>

    <!-- Sidebar Column -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="content-card mb-4 bg-primary text-white bg-gradient">
            <h5 class="mb-4 text-white">Quick Actions</h5>
            <div class="d-grid gap-3">
                <a asp-controller="SalesInvoice" asp-action="Pos" class="btn btn-light text-primary fw-bold text-start p-3 d-flex justify-content-between align-items-center shadow-sm">
                    <span><i class="bi bi-cart-plus me-2"></i> New POS Sale</span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a asp-controller="Shift" asp-action="Current" class="btn btn-primary border-white border-opacity-50 text-start p-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history me-2"></i> Shift Management</span>
                    <i class="bi bi-chevron-right text-white-50"></i>
                </a>
                <a asp-controller="Payment" asp-action="Index" class="btn btn-primary border-white border-opacity-50 text-start p-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-cash-stack me-2"></i> Record Payment</span>
                    <i class="bi bi-chevron-right text-white-50"></i>
                </a>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="content-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0">Recent Activity</h5>
            </div>
            
            <div class="timeline">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="text-center text-muted py-3">No recent activity.</div>
                }
                @foreach (var activity in Model.RecentActivities)
                {
                    <div class="d-flex mb-3 position-relative">
                        <div class="me-3">
                            <div class="icon-circle @activity.Color border border-white border-2 shadow-sm" style="width: 45px; height: 45px; position: relative; z-index: 2;">
                                <i class="bi @activity.Icon"></i>
                            </div>
                        </div>
                        <div class="pb-3 border-bottom w-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1 text-dark fw-bold">@activity.ActivityType</h6>
                                    <p class="mb-1 small text-muted">@activity.Description</p>
                                </div>
                                @if (activity.Amount.HasValue)
                                {
                                    <span class="badge @activity.Color.Replace("-subtle", "").Replace("text-", "bg-") fw-bold shadow-sm">
                                        @DisplayHelpers.Egp(activity.Amount.Value)
                                    </span>
                                }
                            </div>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@activity.Time.ToString("g")</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // Prepare data for Chart.js
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(t => t.Date)));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(t => t.Amount)));

            if (labels.length > 0) {
                var ctx = document.getElementById('salesTrendChart').getContext('2d');
                var gradient = ctx.createLinearGradient(0, 0, 0, 400);
                gradient.addColorStop(0, 'rgba(13, 110, 253, 0.5)'); // Primary color with opacity
                gradient.addColorStop(1, 'rgba(13, 110, 253, 0.05)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Sales Revenue (EGP)',
                            data: data,
                            borderColor: '#0d6efd',
                            backgroundColor: gradient,
                            borderWidth: 3,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#0d6efd',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.parsed.y !== null) {
                                            label += new Intl.NumberFormat('en-EG', { style: 'currency', currency: 'EGP' }).format(context.parsed.y);
                                        }
                                        return label;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: '#e9ecef',
                                    drawBorder: false
                                },
                                ticks: {
                                    callback: function(value, index, values) {
                                        if (value >= 1000) {
                                            return 'EGP ' + (value / 1000).toFixed(1) + 'k';
                                        }
                                        return 'EGP ' + value;
                                    }
                                }
                            },
                            x: {
                                grid: {
                                    display: false,
                                    drawBorder: false
                                }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index',
                        },
                    }
                });
            }
        });
    </script>
    
    <style>
        .timeline::before {
            content: '';
            position: absolute;
            top: 20px;
            bottom: 0;
            left: 22.5px;
            width: 2px;
            background-color: #e9ecef;
            z-index: 1;
        }
        .timeline {
            position: relative;
        }
    </style>
}
