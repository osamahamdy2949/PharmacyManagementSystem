@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="page-header mb-4 border-bottom pb-3">
    <h2 class="fw-bold text-primary"><i class="bi bi-grid-1x2-fill me-2 opacity-75"></i> Overview Dashboard</h2>
    <p class="text-muted mb-0">Welcome back. Here's what's happening with your pharmacy today.</p>
</div>

<div class="row g-4">
    <!-- Top Level Metrics -->
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white;">
            <div class="card-body position-relative overflow-hidden">
                <i class="bi bi-cart-check position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -15px;"></i>
                <h6 class="opacity-75 text-uppercase fw-bold letter-spacing-1">Today's Sales</h6>
                <p class="display-6 fw-bold mb-0">@DisplayHelpers.Egp(Model.TodaySales)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0" style="background: linear-gradient(135deg, #10b981, #059669); color: white;">
            <div class="card-body position-relative overflow-hidden">
                <i class="bi bi-graph-up-arrow position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -15px;"></i>
                <h6 class="opacity-75 text-uppercase fw-bold letter-spacing-1">Today's Profit</h6>
                <p class="display-6 fw-bold mb-0">@DisplayHelpers.Egp(Model.TodayProfit)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: white;">
            <div class="card-body position-relative overflow-hidden">
                <i class="bi bi-bag-plus position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -15px;"></i>
                <h6 class="opacity-75 text-uppercase fw-bold letter-spacing-1">Monthly Sales</h6>
                <p class="display-6 fw-bold mb-0">@DisplayHelpers.Egp(Model.MonthlySales)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white;">
            <div class="card-body position-relative overflow-hidden">
                <i class="bi bi-cash-stack position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -15px;"></i>
                <h6 class="opacity-75 text-uppercase fw-bold letter-spacing-1">Monthly Profit</h6>
                <p class="display-6 fw-bold mb-0">@DisplayHelpers.Egp(Model.MonthlyProfit)</p>
            </div>
        </div>
    </div>

    <!-- Inventory Alerts -->
    <div class="col-12 mt-4 mb-2"><h5 class="fw-bold text-secondary border-bottom pb-2"><i class="bi bi-exclamation-circle text-warning me-2"></i>Inventory Alerts</h5></div>
    <div class="col-md-4">
        <div class="card stat-card h-100 bg-warning bg-opacity-10 border-warning border-opacity-25">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning text-dark rounded-circle p-3 me-3"><i class="bi bi-battery-half fs-4"></i></div>
                <div>
                    <h6 class="text-warning-emphasis fw-bold mb-1 text-uppercase">Low Stock</h6>
                    <p class="display-6 fw-bold text-dark mb-0">@Model.LowStockCount</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100 bg-orange bg-opacity-10 border-warning border-opacity-50" style="background-color: #fff7ed; border-color: #fdba74;">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 me-3" style="background-color: #fed7aa; color: #c2410c;"><i class="bi bi-hourglass-split fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-1 text-uppercase" style="color: #c2410c;">Near Expired</h6>
                    <p class="display-6 fw-bold text-dark mb-0">@Model.NearExpiryCount</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100 bg-danger bg-opacity-10 border-danger border-opacity-25">
            <div class="card-body d-flex align-items-center">
                <div class="bg-danger text-white rounded-circle p-3 me-3"><i class="bi bi-x-octagon-fill fs-4"></i></div>
                <div>
                    <h6 class="text-danger fw-bold mb-1 text-uppercase">Expired</h6>
                    <p class="display-6 fw-bold text-dark mb-0">@Model.ExpiredCount</p>
                </div>
            </div>
        </div>
    </div>

    <!-- General Stats -->
    <div class="col-12 mt-4 mb-2"><h5 class="fw-bold text-secondary border-bottom pb-2"><i class="bi bi-bar-chart-fill text-primary me-2"></i>System Statistics</h5></div>
    
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-primary mb-2"><i class="bi bi-capsule fs-1"></i></div>
                <h6 class="text-muted fw-bold text-uppercase">Total Medicines</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalMedicines</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-info mb-2"><i class="bi bi-box-seam fs-1"></i></div>
                <h6 class="text-muted fw-bold text-uppercase">Inventory Value</h6>
                <h3 class="fw-bold text-dark mb-0">@DisplayHelpers.Egp(Model.InventoryTotalValue)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-success mb-2"><i class="bi bi-people-fill fs-1"></i></div>
                <h6 class="text-muted fw-bold text-uppercase">Customers</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalCustomers</h3>
                <small class="text-success fw-bold"><i class="bi bi-arrow-up-short"></i> @Model.CustomersToday Today</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="text-secondary mb-2"><i class="bi bi-truck fs-1"></i></div>
                <h6 class="text-muted fw-bold text-uppercase">Suppliers</h6>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalSuppliers</h3>
            </div>
        </div>
    </div>
</div>
