@model RecordPaymentViewModel
@{ ViewData["Title"] = "Record Payment"; ViewData["PageTitle"] = "Receive Payment"; }

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="content-card">
            <div class="card-header bg-transparent border-0 mb-3 text-center">
                <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <h4 class="mb-0">Record Customer Payment</h4>
                <p class="text-muted">Receive a payment towards customer debt</p>
            </div>

            <form asp-action="RecordPayment" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                @if (Model.CustomerId == 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Customer (Search by Name or Phone)</label>
                        <select asp-for="CustomerId" class="form-select" id="customerSelect" required>
                            <option value="">-- Select a Customer --</option>
                            @if (ViewBag.CustomersWithDebt != null)
                            {
                                foreach (var c in (IEnumerable<PharmacyManagement.BLL.ViewModels.CustomerViewModels.CustomerViewModel>)ViewBag.CustomersWithDebt)
                                {
                                    <option value="@c.Id" data-debt="@c.RemainingBalance">@c.Name (@c.Phone) - Debt: @DisplayHelpers.Egp(c.RemainingBalance)</option>
                                }
                            }
                        </select>
                    </div>
                    <input type="hidden" asp-for="CustomerTotalDebt" id="CustomerTotalDebt" />
                    <input type="hidden" asp-for="CustomerName" id="CustomerName" />
                }
                else
                {
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CustomerTotalDebt" />
                    <input type="hidden" asp-for="CustomerName" />
                    <div class="mb-3">
                        <label class="form-label">Customer</label>
                        <input type="text" class="form-control bg-light fw-bold text-primary" value="@Model.CustomerName" readonly />
                    </div>
                }
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="card bg-danger-subtle border-danger border-opacity-25 h-100">
                            <div class="card-body py-2">
                                <small class="text-danger-emphasis d-block">Outstanding Balance</small>
                                <span class="fs-5 fw-bold text-danger" id="debtDisplay">@DisplayHelpers.Egp(Model.CustomerTotalDebt)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AmountPaid" class="form-label fw-bold">Amount Paid <span class="text-danger">*</span></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white text-success fw-bold">EGP</span>
                        <input asp-for="AmountPaid" class="form-control text-success fw-bold form-control-lg" type="number" step="0.01" min="0.01" max="@Model.CustomerTotalDebt" />
                    </div>
                    <span asp-validation-for="AmountPaid" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="PaymentDate" class="form-label">Payment Date</label>
                        <input asp-for="PaymentDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Any additional information..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check2-circle me-2"></i> Confirm Payment
                    </button>
                    <a href="javascript:history.back()" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('customerSelect')?.addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];
            if (selectedOption.value) {
                var debt = parseFloat(selectedOption.getAttribute('data-debt'));
                var name = selectedOption.text.split(' - ')[0];
                
                document.getElementById('CustomerTotalDebt').value = debt;
                document.getElementById('CustomerName').value = name;
                document.getElementById('debtDisplay').innerText = debt.toLocaleString('en-US', { style: 'currency', currency: 'EGP' });
                
                var amountInput = document.getElementById('AmountPaid');
                amountInput.max = debt;
                amountInput.value = debt; // Suggest paying the full remaining balance
            } else {
                document.getElementById('CustomerTotalDebt').value = 0;
                document.getElementById('CustomerName').value = '';
                document.getElementById('debtDisplay').innerText = 'EGP 0.00';
                document.getElementById('AmountPaid').value = '';
            }
        });
    </script>
}
