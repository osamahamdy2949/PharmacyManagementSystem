@model PagedList<UserListItemViewModel>
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 text-dark"><i class="bi bi-people-fill me-2 text-primary"></i> User Management</h2>
        <p class="text-muted mb-0">Manage system users, roles, and access.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-person-plus me-2"></i> Add User
        </a>
    </div>
</div>

<div class="content-card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-enterprise mb-0">
            <thead>
                <tr>
                    <th>User Details</th>
                    <th>Email Address</th>
                    <th>System Role</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="4" class="text-center p-5 text-muted"><i class="bi bi-people fs-2 d-block mb-2 opacity-50"></i>No users found.</td></tr>
            }
            @foreach (var u in Model)
            {
                <tr class="bg-white">
                    <td class="fw-bold text-dark">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 border text-primary fw-bold" style="width: 32px; height: 32px;">
                                @(string.IsNullOrWhiteSpace(u.FullName) ? "?" : u.FullName.Substring(0, 1).ToUpper())
                            </div>
                            @u.FullName
                        </div>
                    </td>
                    <td><a href="mailto:@u.Email" class="text-decoration-none text-muted">@u.Email</a></td>
                    <td>
                        @if(u.Roles.Contains("Administrator")) {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-shield-lock me-1"></i> @u.Roles</span>
                        } else if(u.Roles.Contains("Pharmacist")) {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-capsule me-1"></i> @u.Roles</span>
                        } else {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i> @u.Roles</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-light border shadow-sm text-warning fw-bold" title="Reset Password">
                            <i class="bi bi-key-fill me-1"></i> Reset Pass
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
</div>
