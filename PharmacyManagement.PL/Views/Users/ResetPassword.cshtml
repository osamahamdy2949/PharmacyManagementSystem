@model PharmacyManagement.PL.Controllers.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; ViewData["PageTitle"] = "Reset Password"; }
<partial name="_PageHeader" />
<div class="content-card col-md-6">
    <p class="text-muted">Reset password for <strong>@Model.Email</strong></p>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Email" />
        <div class="form-field mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <span asp-validation-for="NewPassword" class="field-error"></span>
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
        </div>
        <partial name="_ModelLevelErrors" />
        <button type="submit" class="btn btn-pharmacy">Reset Password</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
