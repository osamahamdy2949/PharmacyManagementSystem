@model PharmacyManagement.PL.Controllers.ResetPasswordViewModel
@{ 
    ViewData["Title"] = "Reset Password"; 
    ViewData["PageTitle"] = "Reset Password"; 
    ViewData["PageIcon"] = "bi-key-fill";
}
<partial name="_PageHeader" />

<div class="row">
    <div class="col-lg-5">
        <div class="content-card shadow-sm border-0 border-top border-warning border-4">
            <div class="text-center mb-4 mt-2">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-circle mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Administrative Password Reset</h5>
                <p class="text-muted small">You are resetting the password for <strong>@Model.Email</strong></p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                
                <div class="form-floating mb-4">
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="New Password" />
                    <label asp-for="NewPassword">New Password</label>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                
                <partial name="_ModelLevelErrors" />
                
                <div class="d-flex justify-content-between gap-2 mt-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4 border fw-bold shadow-sm text-muted">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm"><i class="bi bi-arrow-clockwise me-2"></i> Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
