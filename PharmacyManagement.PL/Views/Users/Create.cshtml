@model PharmacyManagement.PL.Controllers.CreateUserViewModel
@{ ViewData["Title"] = "Create User"; ViewData["PageTitle"] = "Create User"; }
<partial name="_PageHeader" />
<div class="content-card col-md-6">
    <form asp-action="Create" method="post">
        <div class="form-field mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <span asp-validation-for="FullName" class="field-error"></span>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="form-field mb-3">
            <label asp-for="Email" class="form-label"></label>
            <span asp-validation-for="Email" class="field-error"></span>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="form-field mb-3">
            <label asp-for="Password" class="form-label"></label>
            <span asp-validation-for="Password" class="field-error"></span>
            <input asp-for="Password" class="form-control" />
        </div>
        <div class="form-field mb-3">
            <label asp-for="Role" class="form-label"></label>
            <span asp-validation-for="Role" class="field-error"></span>
            <select asp-for="Role" class="form-select">
                <option value="Administrator">Administrator</option>
                <option value="Pharmacist">Pharmacist</option>
                <option value="Cashier">Cashier</option>
            </select>
        </div>
        <partial name="_ModelLevelErrors" />
        <button type="submit" class="btn btn-pharmacy">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
