@model MedicineViewModel
@{ ViewData["Title"] = "Create Medicine"; ViewData["PageTitle"] = "Create Medicine"; }
<partial name="_PageHeader" />
<div class="content-card">
<form asp-action="Create" method="post">
    <p class="text-muted">Basic medicine information only. Stock, prices, and expiry are set when activating a purchase batch.</p>
    <div class="row">
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="SerialNumber" class="form-label">SKU</label>
            <span asp-validation-for="SerialNumber" class="field-error"></span>
            <input asp-for="SerialNumber" class="form-control" maxlength="30" placeholder="e.g. MED-005" />
        </div>
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="TradeName" class="form-label"></label>
            <span asp-validation-for="TradeName" class="field-error"></span>
            <input asp-for="TradeName" class="form-control" maxlength="50" />
        </div>
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="ScientificName" class="form-label"></label>
            <span asp-validation-for="ScientificName" class="field-error"></span>
            <input asp-for="ScientificName" class="form-control" maxlength="50" />
        </div>
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="MedicineForm" class="form-label">Form</label>
            <span asp-validation-for="MedicineForm" class="field-error"></span>
            <select asp-for="MedicineForm" asp-items="ViewBag.MedicineForms" class="form-select"></select>
        </div>
        <div class="col-md-12 mb-3 form-field">
            <label asp-for="Description" class="form-label"></label>
            <span asp-validation-for="Description" class="field-error"></span>
            <textarea asp-for="Description" class="form-control" maxlength="200" rows="2"></textarea>
        </div>
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="Manufacturer" class="form-label"></label>
            <span asp-validation-for="Manufacturer" class="field-error"></span>
            <input asp-for="Manufacturer" class="form-control" maxlength="50" />
        </div>
        <div class="col-md-6 mb-3 form-field">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <span asp-validation-for="CategoryId" class="field-error"></span>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"><option value="">-- Select --</option></select>
        </div>
    </div>
    <partial name="_ModelLevelErrors" />
    <button type="submit" class="btn btn-pharmacy">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
