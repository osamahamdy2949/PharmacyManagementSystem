@model SalesReturnViewModel
@using PharmacyManagement.BLL.ViewModels.SalesReturnViewModels
@{ ViewData["Title"] = $"Return #{Model.Id}"; }
<div class="content-card">
    <h3>Sales Return #@Model.Id</h3>
    <p><strong>Original Invoice:</strong> #@Model.SalesInvoiceId</p>
    <p><strong>Customer:</strong> @Model.CustomerName</p>
    <p><strong>Date:</strong> @DisplayHelpers.Date(Model.ReturnDate)</p>
    <p><strong>Reason:</strong> @(Model.Reason ?? "—")</p>
    <table class="table table-pharmacy mt-3">
        <thead><tr><th>Medicine</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.MedicineName</td>
                <td>@item.Quantity</td>
                <td>@DisplayHelpers.Egp(item.UnitPrice)</td>
                <td>@DisplayHelpers.Egp(item.Subtotal)</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">Total</th><th>@DisplayHelpers.Egp(Model.TotalAmount)</th></tr></tfoot>
    </table>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
